@{
    Layout = "~/Views/Shared/_LogInLayout.cshtml";
    ViewBag.Title = "Change Password";
}

<div ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController" class="login-shell min-h-screen">
    <div class="login-shell-main grid min-h-screen w-full lg:grid-cols-[60%_40%]">
        <section class="login-showcase relative hidden lg:block">
            <div class="login-carousel-shell">
                <div id="default-carousel" class="absolute inset-0 h-full w-full" data-carousel="slide">
                    <div class="relative h-full overflow-hidden">
                        <div class="duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img1.jpg" class="h-full w-full object-cover" alt="Elegant catering setup">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img2.jpg" class="h-full w-full object-cover" alt="Styled event venue">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img3.jpg" class="h-full w-full object-cover" alt="Signature dining arrangement">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img4.jpg" class="h-full w-full object-cover" alt="Celebration table styling">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img5.jpg" class="h-full w-full object-cover" alt="Refined event presentation">
                        </div>
                    </div>

                    <div class="absolute bottom-10 left-10 z-20">
                        <div class="login-progress" id="loginCarouselProgress" data-carousel-indicators aria-label="Carousel progress">
                            <button type="button" class="login-progress-btn" aria-current="true" data-carousel-slide-to="0" aria-label="Slide 1"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="2" aria-label="Slide 3"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="3" aria-label="Slide 4"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="4" aria-label="Slide 5"></button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-auth-panel flex min-h-screen items-center justify-center px-6 py-10 sm:px-10 lg:px-14">
            <div class="login-form-shell">
                <div class="login-fade relative flex flex-col items-center justify-center text-center">
                    <div class="login-brand-lockup absolute left-1/2 top-[-4.75rem] flex -translate-x-1/2 items-center justify-center gap-3 whitespace-nowrap">
                        <img src="~/Content/images/isabellaLogo.jpg" alt="Isabella Catering and Events Logo" class="h-12 w-12 rounded-lg object-cover">
                        <h1 class="login-header text-lg font-semibold uppercase text-pink-700/85">Isabella Catering</h1>
                    </div>
                    <h2 class="mt-2 text-4xl font-semibold tracking-tight text-zinc-950">Set a New Password</h2>
                    <p class="mt-8 text-sm text-pink-700/70">Choose a new password for your account, then sign in again.</p>
                    <p class="mt-3 text-xs uppercase tracking-[0.2em] text-pink-500/80" ng-if="!resetTokenState.checked">
                        Verifying reset link...
                    </p>
                </div>

                <form class="mt-8 space-y-5" name="changePasswordForm" ng-submit="changeForgotPassword()" novalidate>
                    <div class="login-fade-delayed login-field-group">
                        <div class="mb-2 flex items-center justify-between">
                            <label for="forgetPWord" class="login-label text-sm font-medium text-zinc-800">
                                <span>New Password</span>
                                <span class="login-required">*</span>
                            </label>
                            <small class="login-meta">8 to 20 chars</small>
                        </div>

                        <div class="relative">
                            <input id="forgetPWord"
                                   name="newPasswordField"
                                   ng-model="newPassword"
                                   type="password"
                                   required
                                   ng-minlength="8"
                                   ng-maxlength="20"
                                   minlength="8"
                                   maxlength="20"
                                   oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('toggleForgetPassword').style.display = this.value.length ? 'block' : 'none';"
                                   ng-class="{'login-field-invalid': shouldShowFieldError(changePasswordForm, 'newPasswordField')}"
                                   class="login-field w-full bg-white px-4 py-3 pr-14 text-zinc-900 placeholder-zinc-400 outline-none"
                                   placeholder="Enter your new password" />

                            <span id="toggleForgetPassword"
                                  ng-click="toggleShowForgetPassword()"
                                  class="material-icons absolute w-7 right-3 top-1/2 hidden -translate-y-1/2 cursor-pointer text-gray-500 select-none">
                                visibility_off
                            </span>
                        </div>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(changePasswordForm, 'newPasswordField', 'required')">
                            New password is required.
                        </p>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(changePasswordForm, 'newPasswordField', 'minlength')">
                            Use at least 8 characters.
                        </p>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(changePasswordForm, 'newPasswordField', 'maxlength') || shouldShowFieldError(changePasswordForm, 'newPasswordField', 'ngMaxlength')">
                            Use no more than 20 characters.
                        </p>
                    </div>

                    <div class="login-fade-delayed login-field-group">
                        <div class="mb-2 flex items-center justify-between">
                            <label for="cForgetPWord" class="login-label text-sm font-medium text-zinc-800">
                                <span>Confirm Password</span>
                                <span class="login-required">*</span>
                            </label>
                            <small class="login-meta">Repeat it</small>
                        </div>

                        <div class="relative">
                            <input id="cForgetPWord"
                                   name="confirmPasswordField"
                                   ng-model="cNewPassword"
                                   type="password"
                                   required
                                   ng-minlength="8"
                                   ng-maxlength="20"
                                   minlength="8"
                                   maxlength="20"
                                   oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('toggleCForgetPassword').style.display = this.value.length ? 'block' : 'none';"
                                   ng-class="{'login-field-invalid': shouldShowFieldError(changePasswordForm, 'confirmPasswordField') || isPasswordMismatch(changePasswordForm)}"
                                   class="login-field w-full bg-white px-4 py-3 pr-14 text-zinc-900 placeholder-zinc-400 outline-none"
                                   placeholder="Re-enter your new password" />

                            <span id="toggleCForgetPassword"
                                  ng-click="toggleShowCForgetPassword()"
                                  class="material-icons absolute w-7 right-3 top-1/2 hidden -translate-y-1/2 cursor-pointer text-gray-500 select-none">
                                visibility_off
                            </span>
                        </div>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'required')">
                            Confirm password is required.
                        </p>
                        <p class="login-error"
                           ng-if="!shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'required') && shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'minlength')">
                            Use at least 8 characters.
                        </p>
                        <p class="login-error"
                           ng-if="!shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'required') && (shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'maxlength') || shouldShowFieldError(changePasswordForm, 'confirmPasswordField', 'ngMaxlength'))">
                            Use no more than 20 characters.
                        </p>
                        <p class="login-error"
                           ng-if="isPasswordMismatch(changePasswordForm)">
                            Passwords must match.
                        </p>
                    </div>

                    <button type="submit"
                            ng-disabled="!resetTokenState.valid"
                            ng-class="{'cursor-not-allowed opacity-60': !resetTokenState.valid}"
                            class="login-submit login-fade-delayed w-full rounded-lg bg-pink-500 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-pink-900/10 hover:bg-pink-600">
                        Reset Password
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>
