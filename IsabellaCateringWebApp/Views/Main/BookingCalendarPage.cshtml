@{

    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Calendar Dashboard";
}

<section class="booking-calendar-page min-h-screen"
         ng-init="authenticateLoginCredentials(); renderCalendar()">
    <div class="relative z-10 h-full overflow-y-auto">
    <div class="p-8 mb-5">
        <h1 class="mb-6 text-2xl font-semibold text-black">Booking Calendar</h1>
        <p class="mb-6 text-sm font-medium text-rose-700">
            Select an available date first, then continue to Add Booking. Past dates are disabled.
        </p>

        <section class="panel-surface management-surface booking-calendar-panel relative rounded-lg">
            <div ng-show="calendarLoading" class="management-loader-overlay">
                <div class="management-loader">
                    <span class="management-loader-spinner" aria-hidden="true"></span>
                    <span>Loading calendar</span>
                </div>
            </div>

            <div class="border-b border-rose-100 px-3 py-4 lg:px-4">
                <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                    <div class="booking-month-nav">
                        <button id="prevMonth"
                                type="button"
                                ng-click="togglePrevMonth()"
                                class="booking-nav-btn">
                            <span class="material-icons text-[20px]">chevron_left</span>
                        </button>

                        <span id="currentMonth" class="booking-month-label text-xl font-semibold capitalize text-zinc-950 sm:text-2xl">
                            August 2023
                        </span>

                        <button id="nextMonth"
                                type="button"
                                ng-click="toggleNextMonth()"
                                class="booking-nav-btn">
                            <span class="material-icons text-[20px]">chevron_right</span>
                        </button>
                    </div>

                    <div class="booking-calendar-toolbar flex flex-col gap-3 sm:flex-row sm:items-center">
                        <div class="booking-calendar-search-shell">
                            <div class="booking-calendar-search relative">
                                <div class="booking-calendar-search-field">
                                    <span class="material-symbols-outlined booking-calendar-search-icon pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[20px]">search</span>
                                    <input id="searchCalendar"
                                           type="text"
                                           ng-model="searchState.calendar"
                                           ng-change="findbooking()"
                                           ng-focus="openCalendarSearchDropdown()"
                                           ng-blur="scheduleCalendarSearchClose()"
                                           autocomplete="off"
                                           placeholder="Search bookings"
                                           ng-class="{'booking-toolbar-input--active': calendarSearchOpen, 'booking-toolbar-input--loading': calendarSearchLoading}"
                                           class="booking-toolbar-input booking-toolbar-input--calendar w-full sm:w-[18rem]" />
                                </div>

                            </div>
                        </div>

                        <button id="addBooking"
                                type="button"
                                ng-click="addBooking()"
                                ng-disabled="isCalendarSelectionUnavailable()"
                                class="booking-primary-action inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-semibold">
                            <span class="material-icons text-[18px]">add</span>
                            <span>Add Booking</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="px-3 py-4 lg:px-4 lg:py-5" ng-class="{'management-content-muted': calendarLoading}">
                <div class="grid grid-cols-7 gap-2 pb-3 text-center text-xs font-semibold text-zinc-500 sm:text-sm">
                    <span class="py-2">Sunday</span>
                    <span class="py-2">Monday</span>
                    <span class="py-2">Tuesday</span>
                    <span class="py-2">Wednesday</span>
                    <span class="py-2">Thursday</span>
                    <span class="py-2">Friday</span>
                    <span class="py-2">Saturday</span>
                </div>

                <div id="datepicker-container" class="mt-2">
                    <div id="days-container" class="text-sm font-medium sm:text-base">
                        <div></div>
                        <div></div>
                        <div class="calendar-day">
                            <div class="date-block flex items-center justify-center">1</div>
                            <div class="current"></div>
                        </div>
                        <div class="calendar-day">
                            <div class="date-block flex items-center justify-center">2</div>
                            <div class="current"></div>
                        </div>
                        <div class="calendar-day">
                            <div class="date-block flex items-center justify-center">3</div>
                            <div class="current"></div>
                        </div>
                        <div class="calendar-day">
                            <div class="date-block flex items-center justify-center">4</div>
                            <div class="current"></div>
                        </div>
                        <div class="calendar-day">
                            <div class="date-block flex items-center justify-center">5</div>
                            <div class="current"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    </div>

    <div class="booking-calendar-search-layer"
         ng-if="calendarSearchOpen && searchState.calendar">
        <div id="bookingCalendarSearchDropdown"
             class="booking-calendar-search-dropdown">
            <div class="booking-calendar-search-loading"
                 ng-if="calendarSearchLoading">
                <span class="booking-calendar-search-loading-spinner" aria-hidden="true"></span>
                <span>Searching bookings</span>
            </div>

            <ul class="booking-calendar-search-results"
                ng-if="calendarSearchResults.length > 0">
                <li class="booking-calendar-search-result-row"
                    ng-repeat="result in calendarSearchResults track by result.bookingID">
                    <button type="button"
                            class="booking-calendar-search-item"
                            ng-class="{'is-preview': livePreviewBookingId === (result.bookingID + '')}"
                            ng-mousedown="selectCalendarSearchResult(result, $event)">
                        <span class="booking-calendar-search-item-content">
                            <span class="booking-calendar-search-item-row">
                                <span class="booking-calendar-search-item-title"
                                      title="{{ result.eventName || ('Booking #' + result.bookingID) }}">{{ result.eventName || ('Booking #' + result.bookingID) }}</span>
                                <span class="booking-calendar-search-item-id"
                                      ng-if="livePreviewBookingId !== (result.bookingID + '')">#{{ result.bookingID }}</span>
                            </span>
                            <span class="booking-calendar-search-item-meta"
                                  title="{{ result.bookingVenue || 'No venue' }}">{{ result.bookingVenue || 'No venue' }}</span>
                            <span class="booking-calendar-search-item-meta"
                                  title="{{ formatCalendarSearchResultDate(result.bookingDate) }}{{ result.eventTime ? (' at ' + formatCalendarSearchResultTime(result.eventTime)) : '' }}">{{ formatCalendarSearchResultDate(result.bookingDate) }}<span ng-if="result.eventTime"> at {{ formatCalendarSearchResultTime(result.eventTime) }}</span></span>
                        </span>
                    </button>
                </li>
            </ul>

            <div class="booking-calendar-search-status"
                 ng-if="!calendarSearchLoading && calendarSearchResults.length === 0">
                No bookings found.
            </div>
        </div>
    </div>
</section>
