@{
    Layout = "~/Views/Shared/_LogInLayout.cshtml";
    ViewBag.Title = "Isabella Catering - Exquisite Catering Services";
}

<div class="min-h-screen bg-gray-50 font-['Montserrat'] text-gray-900" ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController" ng-init="initLandingPage()">

    <!-- Hero Section -->
    <div class="relative h-[90vh] flex items-center overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img src="@Url.Content("~/Content/images/landingbg.jpg")" alt="Catering Background" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-pink-600/60 via-pink-300/40 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
            <div class="max-w-3xl">
                <h1 class="text-6xl lg:text-8xl font-black text-white mb-6 leading-[1.1] tracking-tight font-['Josefin_Sans'] [text-shadow:_0_4px_8px_rgba(0,0,0,0.2),_0_10px_20px_rgba(0,0,0,0.6)]">
                    <span class="text-pink-500">Isabella</span><br /> Catering Services
                </h1>

                <p class="text-xl text-gray-900 mb-10 leading-relaxed max-w-2xl font-semibold">
                    From intimate gatherings to grand celebrations, we transform your special moments into unforgettable culinary experiences.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="#packages" class="px-6 py-3 bg-pink-600 text-white rounded-xl font-bold text-base hover:bg-pink-700 transition-all shadow-lg shadow-pink-600/20 active:scale-95">
                        Explore Packages
                    </a>
                    <a href="@Url.Action("LoginPage", "Main")" class="px-6 py-3 bg-white/10 backdrop-blur-md text-white border border-white/20 rounded-xl font-bold text-base hover:bg-white/20 transition-all active:scale-95">
                        Client Login
                    </a>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute inset-x-0 bottom-12 flex flex-col items-center gap-3 animate-bounce">
            <span class="text-white text-[10px] font-black uppercase tracking-[0.3em]">Scroll to explore</span>
            <span class="material-symbols-outlined text-white/40 text-3xl">expand_more</span>
        </div>
    </div>

    <!-- Navigation -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-gray-100">
        <nav class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-20 h-20 flex items-center justify-center shadow-pink-600/20">
                    <img src="@Url.Content("~/Content/images/isabella.png")" alt="Alternate Text" />
                </div>
                <div>
                    <span class="text-2xl font-black text-gray-900 tracking-tighter">ISABELLA<span class="text-pink-600">.</span></span>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest -mt-1">Catering & Events</p>
                </div>
            </div>

            <div class="hidden md:flex items-center gap-8">
                <a href="#regular" class="text-sm font-bold text-gray-600 hover:text-pink-600 transition-colors uppercase tracking-widest">Regular</a>
                <a href="#kiddie" class="text-sm font-bold text-gray-600 hover:text-pink-600 transition-colors uppercase tracking-widest">Kiddie</a>
                <a href="#debut" class="text-sm font-bold text-gray-600 hover:text-pink-600 transition-colors uppercase tracking-widest">Debut</a>
                <a href="#wedding" class="text-sm font-bold text-gray-600 hover:text-pink-600 transition-colors uppercase tracking-widest">Wedding</a>
            </div>

            <a href="@Url.Action("LoginPage", "Main")" class="hidden md:flex items-center gap-2 px-6 py-3 bg-pink-600 text-white rounded-xl font-bold hover:bg-black transition-all shadow-lg shadow-gray-200">
                <span class="material-symbols-outlined text-xl">login</span>
                Login
            </a>
        </nav>
    </header>

    <!-- Packages Sections -->
    <main id="packages" class="max-w-7xl mx-auto px-6 py-16 space-y-20">

        <!-- Regular Section -->
        <section id="regular" class="scroll-mt-24">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="h-px w-8 bg-pink-500"></span>
                        <span class="text-pink-600 font-black uppercase tracking-widest text-[10px]">Elegant Selection</span>
                    </div>
                    <h2 class="text-3xl font-black text-gray-900 font-['Josefin_Sans'] uppercase tracking-tight">Regular Packages</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div ng-repeat="pkg in regularPackages" class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-100">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img ng-src="{{pkg.Image}}" alt="{{pkg.Title}}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-black text-gray-900 mb-2 font-['Josefin_Sans'] uppercase tracking-tight">{{pkg.Title}}</h3>
                        <p class="text-gray-500 mb-6 line-clamp-2 text-xs font-bold leading-relaxed">{{pkg.Description}}</p>
                        <button ng-click="openPackageCard(pkg.Title)" class="w-full flex items-center justify-center gap-2 py-3 bg-gray-50 text-gray-900 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-pink-600 hover:text-white transition-all group/btn border border-gray-100 hover:border-pink-600">
                            Explore Package
                            <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Kiddie Section -->
        <section id="kiddie" class="scroll-mt-24">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="h-px w-8 bg-pink-500"></span>
                        <span class="text-pink-600 font-black uppercase tracking-widest text-[10px]">Joyful Celebrations</span>
                    </div>
                    <h2 class="text-3xl font-black text-gray-900 font-['Josefin_Sans'] uppercase tracking-tight">Kiddie Packages</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div ng-repeat="pkg in kiddiePackages" class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-100">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img ng-src="{{pkg.Image}}" alt="{{pkg.Title}}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-black text-gray-900 mb-2 font-['Josefin_Sans'] uppercase tracking-tight">{{pkg.Title}}</h3>
                        <p class="text-gray-500 mb-6 line-clamp-2 text-xs font-bold leading-relaxed">{{pkg.Description}}</p>
                        <button ng-click="openPackageCard(pkg.Title)" class="w-full flex items-center justify-center gap-2 py-3 bg-gray-50 text-gray-900 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-pink-600 hover:text-white transition-all group/btn border border-gray-100 hover:border-pink-600">
                            Explore Package
                            <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Debut Section -->
        <section id="debut" class="scroll-mt-24">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="h-px w-8 bg-pink-500"></span>
                        <span class="text-pink-600 font-black uppercase tracking-widest text-[10px]">Magical Moments</span>
                    </div>
                    <h2 class="text-3xl font-black text-gray-900 font-['Josefin_Sans'] uppercase tracking-tight">Debut Packages</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div ng-repeat="pkg in debutPackages" class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-100">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img ng-src="{{pkg.Image}}" alt="{{pkg.Title}}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-black text-gray-900 mb-2 font-['Josefin_Sans'] uppercase tracking-tight">{{pkg.Title}}</h3>
                        <p class="text-gray-500 mb-6 line-clamp-2 text-xs font-bold leading-relaxed">{{pkg.Description}}</p>
                        <button ng-click="openPackageCard(pkg.Title)" class="w-full flex items-center justify-center gap-2 py-3 bg-gray-50 text-gray-900 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-pink-600 hover:text-white transition-all group/btn border border-gray-100 hover:border-pink-600">
                            Explore Package
                            <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Wedding Section -->
        <section id="wedding" class="scroll-mt-24">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="h-px w-8 bg-pink-500"></span>
                        <span class="text-pink-600 font-black uppercase tracking-widest text-[10px]">Lifetime Promises</span>
                    </div>
                    <h2 class="text-3xl font-black text-gray-900 font-['Josefin_Sans'] uppercase tracking-tight">Wedding Packages</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div ng-repeat="pkg in weddingPackages" class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-100">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img ng-src="{{pkg.Image}}" alt="{{pkg.Title}}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-black text-gray-900 mb-2 font-['Josefin_Sans'] uppercase tracking-tight">{{pkg.Title}}</h3>
                        <p class="text-gray-500 mb-6 line-clamp-2 text-xs font-bold leading-relaxed">{{pkg.Description}}</p>
                        <button ng-click="openPackageCard(pkg.Title)" class="w-full flex items-center justify-center gap-2 py-3 bg-gray-50 text-gray-900 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-pink-600 hover:text-white transition-all group/btn border border-gray-100 hover:border-pink-600">
                            Explore Package
                            <span class="material-symbols-outlined text-sm transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-pink-200 text-white py-24">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-20">
            <div>
                <div class="flex items-center gap-6 mb-10">
                    <div class="w-28 h-28 flex items-center justify-center shadow-pink-600/20">
                        <img src="@Url.Content("~/Content/images/isabella.png")" alt="Alternate Text" class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <span class="text-4xl font-black text-gray-900 tracking-tighter">ISABELLA<span class="text-pink-600">.</span></span>
                        <p class="text-xs font-bold text-pink-600 uppercase tracking-[0.25em] -mt-1">Catering & Events</p>
                    </div>
                </div>
                <p class="text-black font-medium text-xl leading-relaxed mb-12 max-w-lg">
                    Creating timeless memories through exquisite food and impeccable service. Your celebration deserves nothing less than perfection.
                </p>
                <div class="flex gap-6">
                    <a href="https://www.facebook.com/profile.php?id=100054473649178" target="_blank"
                       class="w-14 h-14 rounded-full bg-pink-600 flex items-center justify-center hover:bg-pink-700 transition-all text-white shadow-lg shadow-pink-600/30">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-40 justify-between">
                <div class="max-w-md">
                    <h4 class="text-lg font-bold mb-8 uppercase tracking-widest text-pink-500">Contact Us</h4>
                    <ul class="space-y-6 text-black font-medium">
                        <li class="flex items-start gap-4">
                            <div class="flex items-center justify-center shrink-0"
                                 style="width: 40px; height: 40px; background-color: #db2777; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(219, 39, 119, 0.3);">
                                <span class="material-symbols-outlined" style="color: white !important;">location_on</span>
                            </div>
                            <span class="leading-relaxed text-sm pt-1">Ph 9A, Blk 48, L35 & 37, Savinhill St., Governor’s Hills Subdivision, General Trias, Cavite, Philippines</span>
                        </li>

                        <li class="flex items-start gap-4">
                            <div class="flex items-center justify-center shrink-0"
                                 style="width: 40px; height: 40px; background-color: #db2777; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(219, 39, 119, 0.3);">
                                <span class="material-symbols-outlined" style="color: white !important;">call</span>
                            </div>
                            <div class="text-sm pt-1">
                                <span class="block font-bold">Tel: (046) 482-3087</span>
                                <span class="block mt-1 font-black" style="color: #db2777;">Mob: 0917-711-1401</span>
                                <span class="block">0926-006-9234</span>
                            </div>
                        </li>

                        <li class="flex items-center gap-4">
                            <div class="flex items-center justify-center shrink-0"
                                 style="width: 40px; height: 40px; background-color: #db2777; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(219, 39, 119, 0.3);">
                                <span class="material-symbols-outlined" style="color: white !important;">mail</span>
                            </div>
                            <span class="text-sm font-bold">isabellacateringandevent@gmail.com</span>
                        </li>
                    </ul>
                </div>

                <div class="flex flex-col items-start">
                    <h4 class="text-pink-600 font-bold uppercase tracking-widest mb-10">Quick Links</h4>
                    <ul class="space-y-6 text-gray-900 font-black">
                        <li><a href="#top" class="hover:text-pink-600 transition-all flex items-center gap-2">Home</a></li>
                        <li><a href="#packages" class="hover:text-pink-600 transition-all flex items-center gap-2">Packages</a></li>
                        <li><a href="@Url.Action("LoginPage", "Main")" class="hover:text-pink-600 transition-all flex items-center gap-2">Login</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 pt-20 mt-20 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-gray-500 font-medium">© 2026 Isabella Catering. All rights reserved.</p>
            <p class="text-gray-500 font-medium flex items-center gap-2">
                Made with <span class="material-symbols-outlined text-pink-600 text-sm">favorite</span> for special moments.
            </p>
        </div>
    </footer>

    <!-- Package Details Modal -->
    <div id="packageCardModal"
         class="fixed inset-0 z-[100] flex items-center justify-center p-4 transition-all duration-300"
         ng-show="showPackageCardModal"
         ng-cloak>
        <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-[2px]" ng-click="closePackageCardModal()"></div>

        <div class="relative bg-white w-full max-w-5xl rounded-[2rem] overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-300">
            <!-- Loading State -->
            <div ng-if="packageCardLoading" class="absolute inset-0 z-10 bg-white/80 backdrop-blur-sm flex flex-col items-center justify-center gap-3">
                <div class="w-10 h-10 border-4 border-pink-100 border-t-pink-600 rounded-full animate-spin"></div>
                <p class="text-gray-400 text-xs font-bold">Loading details...</p>
            </div>

            <!-- Content -->
            <div class="flex flex-col md:flex-row h-full max-h-[80vh]">
                <!-- Modal Left: Image Carousel -->
                <div class="md:w-5/12 relative bg-gray-100 group min-h-[300px] md:min-h-0">
                    <div class="h-full overflow-hidden relative">
                        <div ng-repeat="img in selectedPackageDetails.carouselImages" 
                             ng-show="currentSlide == $index"
                             class="absolute inset-0 transition-opacity duration-500 ease-in-out">
                            <img ng-src="{{img}}" class="w-full h-full object-cover" alt="Event Image">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                        </div>
                    </div>

                    <!-- Carousel Controls -->
                    <button ng-click="prevSlide()" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/20 hover:bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center text-white transition-all opacity-0 group-hover:opacity-100">
                        <span class="material-symbols-outlined text-xl">chevron_left</span>
                    </button>
                    <button ng-click="nextSlide()" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/20 hover:bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center text-white transition-all opacity-0 group-hover:opacity-100">
                        <span class="material-symbols-outlined text-xl">chevron_right</span>
                    </button>

                    <!-- Carousel Dots -->
                    <div class="absolute bottom-6 left-6 flex gap-1.5">
                        <button ng-repeat="img in selectedPackageDetails.carouselImages" 
                                ng-click="setSlide($index)"
                                class="w-2 h-2 rounded-full transition-all"
                                ng-class="currentSlide == $index ? 'bg-pink-500 w-6' : 'bg-white/40'"></button>
                    </div>
                    
                    <!-- Package Info Overlay -->
                    <div class="absolute bottom-10 left-6 right-6 text-white pointer-events-none">
                        <h2 class="text-3xl text-white mb-2 font-['Josefin_Sans'] leading-tight [text-shadow:_0_0_15px_rgba(236,72,163,0.6)]">{{selectedPackageDetails.packageName}}</h2>
                        <p class="text-gray-200 text-sm font-medium line-clamp-2 leading-relaxed">{{selectedPackageDetails.description}}</p>
                    </div>
                    
                    <button ng-click="closePackageCardModal()" class="absolute top-6 left-6 flex items-center gap-2 px-4 py-2 bg-black/30 hover:bg-black/50 backdrop-blur-md rounded-lg text-white text-[10px] font-black uppercase tracking-widest transition-all">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Back
                    </button>
                </div>

                <!-- Modal Right: Inclusions -->
                <div class="md:w-7/12 p-8 lg:p-10 overflow-y-auto scrollbar-hide flex flex-col bg-white">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xl font-black text-gray-900 font-['Josefin_Sans'] uppercase tracking-tight">Package Inclusions</h3>
                        <span class="px-3 py-1 bg-pink-50 text-pink-600 rounded-lg text-[10px] font-black uppercase tracking-widest">Premium</span>
                    </div>

                    <div class="grid grid-cols-1 gap-2 flex-grow">
                        <div ng-repeat="item in selectedPackageDetails.inclusions"
                             class="flex items-center gap-3 p-3 bg-gray-50/50 rounded-xl border border-gray-100 hover:border-pink-100 hover:bg-white transition-all">
                            <div class="w-6 h-6 rounded-lg bg-white text-pink-600 flex items-center justify-center shrink-0 shadow-sm border border-pink-50">
                                <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                            </div>
                            <span class="text-gray-600 font-bold text-xs leading-relaxed">{{item}}</span>
                        </div>
                    </div>

                    <!-- Book Button -->
                    <div class="mt-8 flex items-center justify-between gap-4 p-5 bg-pink-200 rounded-2xl text-white">
                        <div class="hidden sm:block">
                            <p class="text-pink-500 text-[9px] font-black uppercase tracking-widest">Ready to book?</p>
                            <p class="text-base text-black font-black font-['Josefin_Sans']">Secure your date</p>
                        </div>
                        <a href="@Url.Action("RequestCalendarPage", "Main")" 
                           class="group/btn relative flex items-center gap-2 px-6 py-3 bg-pink-600 text-white rounded-xl font-black transition-all hover:bg-pink-500 active:scale-95 shadow-lg shadow-pink-600/20 text-center flex-grow sm:flex-grow-0">
                            <span class="uppercase tracking-widest text-[10px]">Reserve Now</span>
                            <span class="material-symbols-outlined text-lg">calendar_month</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    html {
        scroll-behavior: smooth;
    }

    [ng-cloak] {
        display: none !important;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Custom Animations */
    @@keyframes fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes zoom-in {
        from {
            transform: scale(0.95);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .animate-in {
        animation-fill-mode: forwards;
    }

    .fade-in {
        animation-name: fade-in;
    }

    .zoom-in {
        animation-name: zoom-in;
    }

    @@keyframes shimmer {
        100% {
            transform: translateX(100%);
        }
    }
</style>
