@{
    Layout = "~/Views/Shared/_LogInLayout.cshtml";
    ViewBag.Title = "Request Booking";
}

<section class="request-booking-page min-h-screen"
         ng-init="initializeRequestCalendar()">
    <div class="relative z-10 h-full overflow-y-auto">
        <div class="p-8 mb-5">
            <h1 class="mb-6 text-2xl font-semibold text-black">Request a Booking</h1>
            <p class="mb-6 text-sm font-medium text-rose-700">
                Select an available date (starting 4 days from today) to request your booking. Dates with 3 or more bookings are disabled.
            </p>

            <section class="panel-surface management-surface request-calendar-panel relative rounded-lg max-w-2xl">
                <div ng-show="requestCalendarLoading" class="management-loader-overlay">
                    <div class="management-loader">
                        <span class="management-loader-spinner" aria-hidden="true"></span>
                        <span>Loading calendar</span>
                    </div>
                </div>

                <div class="border-b border-rose-100 px-3 py-4 lg:px-4">
                    <div class="flex flex-col gap-4">
                        <div class="booking-month-nav flex items-center justify-center">
                            <button id="requestPrevMonthBtn"
                                    type="button"
                                    ng-click="navigateToPreviousMonth()"
                                    ng-disabled="!canNavigateToPrevMonth()"
                                    class="booking-nav-btn">
                                <span class="material-icons text-[20px]">chevron_left</span>
                            </button>

                            <span id="requestCurrentMonthLabel" class="booking-month-label text-lg font-semibold capitalize text-zinc-950 sm:text-xl px-6 min-w-[200px] text-center">
                                Loading...
                            </span>

                            <button id="requestNextMonthBtn"
                                    type="button"
                                    ng-click="navigateToNextMonth()"
                                    ng-disabled="!canNavigateToNextMonth()"
                                    class="booking-nav-btn">
                                <span class="material-icons text-[20px]">chevron_right</span>
                            </button>
                        </div>

                        <div class="flex justify-center">
                            <button id="submitRequestBtn"
                                    type="button"
                                    ng-click="submitBookingRequest()"
                                    ng-disabled="!isRequestDateSelected()"
                                    class="booking-primary-action inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold">
                                <span class="material-icons text-[18px]">event_available</span>
                                <span>Request This Date</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="px-4 py-5" ng-class="{'management-content-muted': requestCalendarLoading}">
                    <div class="grid grid-cols-7 gap-1 pb-3 text-center text-[11px] font-semibold text-zinc-500">
                        <span class="py-1">Sun</span>
                        <span class="py-1">Mon</span>
                        <span class="py-1">Tue</span>
                        <span class="py-1">Wed</span>
                        <span class="py-1">Thu</span>
                        <span class="py-1">Fri</span>
                        <span class="py-1">Sat</span>
                    </div>

                    <div id="request-datepicker-container" class="mt-1">
                        <div id="request-days-container" class="grid grid-cols-7 gap-1">
                            <!-- Calendar days will be rendered here -->
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <div class="flex flex-wrap gap-3 justify-center text-xs">
                            <div class="flex items-center gap-1.5">
                                <div class="w-6 h-6 rounded-md border-2 border-[#D6418B] bg-white"></div>
                                <span class="text-gray-600">Available</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-6 h-6 rounded-md bg-[#EC4899]"></div>
                                <span class="text-gray-600">Selected</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-6 h-6 rounded-md bg-gray-100 border border-gray-200"></div>
                                <span class="text-gray-600">Unavailable</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>