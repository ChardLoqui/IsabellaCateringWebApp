@{
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Admin Booking View";
}

<main class="customer-view-shell min-h-screen bg-gray-50 text-gray-900 antialiased"
      ng-init="getOrderInfo();">

    <div class="relative z-10 h-full overflow-y-auto">
    <div class="mb-5 p-8">
        <h1 class="mb-6 text-2xl font-semibold text-black">Event Progress</h1>

        <div ng-if="orderLoading" class="management-surface management-loader-shell mt-4">
            <div class="management-loader">
                <span class="management-loader-spinner" aria-hidden="true"></span>
                <span>Loading event details</span>
            </div>
        </div>

        <div ng-if="!orderLoading && order" class="management-content-fade">
        <section class="management-surface mt-4 rounded-lg p-5">
            <div class="flex flex-col gap-2 border-b border-gray-100 pb-3 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Progress</h2>
                    <p class="mt-1 text-sm text-gray-500">
                        Current booking stage from planning to event day.
                    </p>
                </div>

                <p class="text-sm font-medium text-pink-600">
                    {{ (order.progressOne == 1 ? 1 : 0) + (order.progressTwo == 1 ? 1 : 0) + (order.progressThree == 1 ? 1 : 0) }} of 3 stages complete
                </p>
            </div>

            <div class="mt-4">
                <div class="flex items-center">
                    <div ng-repeat="step in steps" class="relative flex w-full items-center">
                        <div ng-if="!$first"
                             class="h-1.5 flex-1"
                             ng-class="step.completed ? 'bg-pink-500' : 'bg-gray-300'">
                        </div>

                        <div class="z-10 flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold"
                             ng-class="step.completed ? 'bg-pink-500 text-white' : 'bg-gray-300 text-gray-700'">
                            <span ng-if="step.completed">&#10003;</span>
                            <span ng-if="!step.completed">{{ step.icon }}</span>
                        </div>

                        <div ng-if="!$last"
                             class="h-1.5 flex-1"
                             ng-class="step.completed ? 'bg-pink-500' : 'bg-gray-300'">
                        </div>
                    </div>
                </div>

                <div class="mt-2 flex justify-between text-sm text-gray-500">
                    <span ng-repeat="step in steps" class="flex-1 px-1 text-center">
                        {{ step.label }}
                    </span>
                </div>
            </div>
        </section>

        <section class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,2fr)_320px]">
            <div class="space-y-4">
                <section class="management-surface rounded-lg p-5">
                    <div class="flex flex-col gap-3 border-b border-gray-100 pb-3 lg:flex-row lg:items-start lg:justify-between">
                        <div>
                            <h2 class="text-xl font-semibold text-gray-900">
                                {{ package && packageTypeInfo ? packageTypeInfo : 'Package Details' }}
                            </h2>
                            <p class="mt-1 text-sm text-gray-500">
                                Package reference and style details for this booking.
                            </p>
                        </div>

                        <div class="rounded-md bg-pink-50 px-3 py-2 text-sm font-medium text-pink-600">
                            Design and inclusion overview
                        </div>
                    </div>

                    <div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.9fr)]">
                        <div>
                            <p class="text-sm font-medium text-gray-900">Included items</p>

                            <ul ng-if="package && package.items && package.items.length"
                                class="mt-3 space-y-2 text-sm text-gray-600">
                                <li ng-repeat="item in package.items" class="flex items-start gap-3">
                                    <span class="text-lg text-pink-500">o</span>
                                    <span>{{ item }}</span>
                                </li>
                            </ul>

                            <p ng-if="!package || !package.items || !package.items.length"
                               class="mt-3 text-sm text-gray-500">
                                Itemized package inclusions are not available on this page yet.
                            </p>
                        </div>

                        <div class="grid content-start gap-2">
                            <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
                                <p class="text-sm font-medium text-gray-500">Theme</p>
                                <p class="mt-1 text-base font-semibold text-gray-900">
                                    {{ order.dsgnTheme || 'Not set' }}
                                </p>
                            </div>

                            <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
                                <p class="text-sm font-medium text-gray-500">Motif</p>
                                <p class="mt-1 text-base font-semibold text-gray-900">
                                    {{ order.dsgnMotif || 'Not set' }}
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="management-surface rounded-lg p-5">
                    <div class="border-b border-gray-100 pb-3">
                        <h2 class="text-xl font-semibold text-gray-900">Event Details</h2>
                        <p class="mt-1 text-sm text-gray-500">
                            Scheduled date, venue, and service times for the booking.
                        </p>
                    </div>

                    <dl class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Date</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.bookingDate || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Venue</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.venue || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Preparation Venue</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.prepVenue || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Setup Time</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.eventSetTime || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Ceremony</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.ceremTime || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                            <dt class="text-sm font-medium text-gray-500">Event Time</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.eventTime || 'Not set' }}</dd>
                        </div>

                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 sm:col-span-2 xl:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Meal Time</dt>
                            <dd class="mt-1 text-base font-semibold text-gray-900">{{ order.eventMealTime || 'Not set' }}</dd>
                        </div>
                    </dl>
                </section>
            </div>

            <aside class="space-y-6">
                <section class="management-surface rounded-lg p-5">
                    <h2 class="text-xl font-semibold text-gray-900">Client Information</h2>

                    <dl class="mt-4 space-y-3">
                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Client</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.fullName || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Event</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.eventName || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.email || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Contact</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.contact || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Celebrant 1</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.celebrantOne || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Celebrant 2</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ client.celebrantTwo || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Created</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ order.dateCreated || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4">
                            <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ order.dateUpdated || 'Not set' }}</dd>
                        </div>
                    </dl>
                </section>

                <section class="management-surface rounded-lg p-5">
                    <h2 class="text-xl font-semibold text-gray-900">Reservation Details</h2>

                    <dl class="mt-4 space-y-3">
                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Guest Count</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ order.paxCount || 'Not set' }} Pax</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3" ng-if="order.addAdult == 0? false : true">
                            <dt class="text-sm font-medium text-gray-500">Additional Adult</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ order.addAdult || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3" ng-if="order.addKid == 0? false : true">
                            <dt class="text-sm font-medium text-gray-500">Additional Kids</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">{{ order.addKid || 'Not set' }}</dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3" ng-if="bookingAdditionalsView && bookingAdditionalsView.length">
                            <dt class="text-sm font-medium text-gray-500">Additional Charges</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">
                                <div ng-repeat="item in bookingAdditionalsView track by $index">{{ item.description }} - ₱ {{ item.amount }}</div>
                            </dd>
                        </div>

                        <div class="flex items-start justify-between gap-4 border-b border-gray-100 pb-3">
                            <dt class="text-sm font-medium text-gray-500">Final Price</dt>
                            <dd class="text-right text-sm font-semibold text-gray-900">₱ {{ payment.paymentInitial || 'Not set' }}</dd>
                        </div>

                    </dl>
                </section>

                <div class="mt-4 space-y-3">
                    <button type="button"
                            ng-click="requestCancellation()"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-bold text-red-600 border border-red-200 shadow-sm transition-all hover:bg-red-50 active:scale-[0.98]">
                        <span class="material-symbols-outlined text-[20px]">event_busy</span>
                        Request Cancellation
                    </button>
                </div>
            </aside>
        </section>
        </div>
    </div>
    </div>
</main>



