@{
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Account Management";
}

<div class="container mx-auto h-screen p-10">
    @* Header *@
    <h1 class="text-2xl font-semibold text-black mb-6">Account Management</h1>

    @* Search & Pagination Container *@
    <div class="flex items-center justify-between mb-8 w-full">

        <div class="flex items-center gap-2">
            <input id="searchEmail"
                   type="text"
                   placeholder="Search by email..."
                   class="w-96 px-5 rounded bg-gray-100 p-2 focus:outline-none border border-transparent focus:border-pink-500 transition-all" />

            <button type="button"
                    class="px-5 rounded bg-pink-500 py-2 text-white font-semibold hover:bg-pink-600 shadow-md transition-colors">
                Search
            </button>

            <button data-modal-target="add" data-modal-toggle="add"
                    class="px-5 rounded bg-pink-500 py-2 text-white font-semibold hover:bg-pink-600 shadow-md transition-colors"
                    type="button">
                New Account +
            </button>

            <div id="add" tabindex="-1" aria-hidden="true"
                 class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">

                <div class="relative w-full max-w-sm p-4">

                    <form ng-submit="addUsrSubmit()" class="bg-white rounded-2xl shadow-xl p-7 relative">

                        <button type="button"
                                class="absolute top-4 right-2 text-pink-500 hover:text-pink-600 font-bold"
                                data-modal-hide="add">
                            <span class="material-symbols-outlined text-2xl">close</span>
                        </button>

                        <div class="flex items-end justify-between mb-5 mt-1">
                            <div class="border-b border-gray-300 pb-1 w-[55%]">
                                <h3 class="text-xl font-bold text-gray-800">
                                    New Account
                                </h3>
                            </div>

                            <div class="relative w-28 pb-1">
                                <select ng-model="permissionID" class="appearance-none w-24 bg-pink-100 text-gray-800 text-xs font-bold rounded-lg px-2 py-2 pr-4 focus:outline-none focus:ring-2 focus:ring-pink-300 cursor-pointer">
                                    <option value="1">ADMIN</option>
                                    <option value="2">STAFF</option>
                                    <option value="3">USER</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-6 flex items-center text-gray-800 pb-1">
                                    <span class="material-symbols-outlined text-base">expand_more</span>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-800 mb-1">
                                    Account First Name
                                </label>
                                <input type="text" ng-model="firstName"
                                       class="w-full bg-pink-100 rounded-md px-3 py-2 border-none focus:outline-none focus:ring-2 focus:ring-pink-400"
                                       required>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-800 mb-1">
                                    Account Last Name
                                </label>
                                <input type="text" ng-model="lastName"
                                       class="w-full bg-pink-100 rounded-md px-3 py-2 border-none focus:outline-none focus:ring-2 focus:ring-pink-400"
                                       required>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-800 mb-1">
                                    Account E-mail
                                </label>
                                <input type="email" ng-model="email"
                                       class="w-full bg-pink-100 rounded-md px-3 py-2 border-none focus:outline-none focus:ring-2 focus:ring-pink-400"
                                       required>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-800 mb-1">
                                    Password
                                </label>
                                <input type="password" ng-model="password"
                                       class="w-full bg-pink-100 rounded-md px-3 py-2 border-none focus:outline-none focus:ring-2 focus:ring-pink-400"
                                       required>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-800 mb-1">
                                    Re-enter Password
                                </label>
                                <input type="password" ng-model="confirmPassword"
                                       class="w-full bg-pink-100 rounded-md px-3 py-2 border-none focus:outline-none focus:ring-2 focus:ring-pink-400"
                                       required>
                            </div>

                            <div class="flex items-center gap-2 pt-1 pb-2">
                                <input type="checkbox" ng-model="isActive"
                                       class="w-5 h-5 text-pink-500 bg-white border-2 border-pink-400 rounded-md focus:ring-pink-400 cursor-pointer">
                                <label class="text-xs font-bold text-gray-800 cursor-pointer">
                                    Active Account
                                </label>
                            </div>

                            <button type="submit"
                                    class="bg-pink-500 hover:bg-pink-600 text-white font-bold py-2 px-6 rounded-lg shadow-sm transition-colors text-sm">
                                Create Account
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div> 

        <div class="flex items-center gap-4 text-gray-800 font-bold">
            <div class="flex items-center gap-4">
                <div class="h-4 w-[1px] bg-gray-300"></div>

                <button class="hover:text-pink-500 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">chevron_left</span>
                </button>
                <button class="hover:text-pink-500 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">chevron_right</span>
                </button>
                <button class="hover:text-pink-500 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">keyboard_double_arrow_right</span>
                </button>
            </div>

            @* Page Dropdown *@
            <div class="flex items-center border rounded-md bg-white px-3 py-1 gap-2 shadow-sm cursor-pointer">
                <span class="text-sm">1</span>
                <span class="material-symbols-outlined text-gray-400 text-sm">expand_more</span>
            </div>
        </div>
    </div>

    @* Table *@
    <div class="overflow-x-auto shadow-sm rounded-lg">
        <table class="w-full border-collapse bg-gray-100">
            <thead>
                <tr class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-200 bg-white">
                    <th class="p-4">User ID</th>
                    <th class="p-4">Role</th>
                    <th class="p-4">First Name</th>
                    <th class="p-4">Last Name</th>
                    <th class="p-4">Email</th>
                    <th class="p-4">Password</th>
                    <th class="p-4">Last Active</th>
                    <th class="p-4">Status</th>
                    <th class="p-4 text-center">Action</th>
                </tr>
            </thead>

            <tbody class="text-sm text-gray-700 font-bold bg-white">
                <tr ng-repeat="user in usersData" class="border-b border-gray-50 hover:bg-gray-50 transition-colors">

                    <td class="p-4">{{ user.userID }}</td>

                    <td class="p-4">
                        <span ng-if="user.permissionID == 1">Admin</span>
                        <span ng-if="user.permissionID == 2">Staff</span>
                        <span ng-if="user.permissionID == 3">User</span>
                    </td>

                    <td class="p-4">{{ user.firstName }}</td>
                    <td class="p-4">{{ user.lastName }}</td>
                    <td class="p-4">{{ user.email }}</td>

                    <td class="p-4">********</td>

                    <td class="p-4">{{ user.dateUpdated | date:'MM/dd/yyyy' }}</td>

                    <td class="p-4">
                        <span ng-if="user.isActive == 1" class="px-2 py-1 bg-green-100 text-green-700 rounded-md text-xs">Active</span>
                        <span ng-if="user.isActive == 0" class="px-2 py-1 bg-red-100 text-red-700 rounded-md text-xs">Inactive</span>
                    </td>

                    <td class="p-4 text-center">
                        <button class="text-pink-500 hover:text-pink-700 transition-all duration-200 transform hover:scale-110">
                            <span class="material-symbols-outlined flex items-center justify-center">
                                edit_square
                            </span>
                        </button>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>
</div>