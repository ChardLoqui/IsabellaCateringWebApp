@{
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Create Booking";
}

<section class="create-booking-page min-h-screen bg-gray-50 text-gray-900 antialiased"
         ng-init="authenticateLoginCredentials(); initializeBookingFlow()"
         ng-click="handleDocumentClick($event)">
    <div class="relative z-10 h-full overflow-y-auto">
        <div class="management-page-shell">
            <div class="space-y-4">
                <div class="management-page-header">
                    <h1 class="management-page-title">Create Booking</h1>
                </div>

                <form name="eventForm" novalidate>
                    <section class="management-surface rounded-lg p-5" aria-label="Booking progress">
                <div class="flex flex-col gap-2 border-b border-rose-100 pb-3 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h2 class="text-xl font-semibold text-zinc-950">Progress</h2>
                        <p class="mt-1 text-sm text-zinc-500">
                            Follow each booking stage from details to final confirmation.
                        </p>
                    </div>

                    <p class="text-sm font-medium text-pink-600">
                        Step {{ bookingStep }} of {{ bookingFlowSteps.length }}
                    </p>
                </div>

                <div class="mt-4">
                    <div class="booking-progress-track flex items-center">
                        <div ng-repeat="step in bookingFlowSteps" class="relative flex w-full items-center">
                            <div ng-if="!$first"
                                 class="booking-progress-segment h-1.5 flex-1"
                                 ng-class="bookingStep >= step.id ? 'is-complete' : ''">
                            </div>

                            <div class="booking-progress-node z-10 flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold"
                                 ng-class="{'is-complete': bookingStep > step.id, 'is-active': bookingStep === step.id}">
                                <span ng-if="bookingStep > step.id">&#10003;</span>
                                <span ng-if="bookingStep <= step.id">{{ step.icon }}</span>
                            </div>

                            <div ng-if="!$last"
                                 class="booking-progress-segment h-1.5 flex-1"
                                 ng-class="bookingStep > step.id ? 'is-complete' : ''">
                            </div>
                        </div>
                    </div>

                    <div class="mt-2 flex justify-between text-sm text-zinc-500">
                        <span ng-repeat="step in bookingFlowSteps"
                              class="booking-progress-label flex-1 px-1 text-center"
                              ng-class="{'is-active': bookingStep === step.id, 'is-complete': bookingStep > step.id}">
                            {{ step.label }}
                        </span>
                    </div>
                </div>
            </section>

                    <section class="management-surface overflow-visible rounded-lg">
                        <div class="create-booking-form-grid grid w-full grid-cols-1 gap-6 p-5 md:grid-cols-3" ng-init="loadPackageOptions()">

                    <div class="contents" ng-show="bookingStep === 1">

                    <div class="create-booking-section col-span-3">
                        <h2 class="text-xl font-semibold text-zinc-950 sm:text-2xl">Event Details</h2>
                        <p class="mt-2 text-sm leading-6 text-zinc-500">
                            Capture the event schedule, client information, and package inclusions before review.
                        </p>
                    </div>


                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Name <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Isabella's Debut"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="eventName"
                               ng-model="eventName"
                               required
                               ng-blur="markBookingFieldTouched('eventName')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventName')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventName')">{{ getBookingFieldErrorMessage('eventName') }}</p>
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Package <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="markBookingFieldTouched('packageTypeID'); toggleDropdown('packageTypesOpt', $event)"
                                   ng-class="{'booking-field-invalid': shouldShowBookingFieldError('packageTypeID')}"
                                   ng-value="getPackageDisplayText()" />
                            <div ng-if="activeDropdown ==='packageTypesOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="package in packageTypesOpt"
                                     ng-click="selectPackageTypes(package.packageTypDesc, package.packageTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': packageType===package.packageTypDesc}">
                                    {{package.packageTypDesc}}
                                </div>
                            </div>
                        </div>
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('packageTypeID')">{{ getBookingFieldErrorMessage('packageTypeID') }}</p>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Type <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="markBookingFieldTouched('eventTypeID'); toggleDropdown('eventsOpt', $event)"
                                   ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventTypeID')}"
                                   ng-value="getEventDisplayText()" />
                            <div ng-if="activeDropdown ==='eventsOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="event in eventsOpt"
                                     ng-click="selectEventTypes(event.eventDesc, event.eventID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventType===event.eventDesc}">
                                    {{event.eventDesc}}
                                </div>
                            </div>
                        </div>
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventTypeID')">{{ getBookingFieldErrorMessage('eventTypeID') }}</p>
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Client's Firstname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cFirstName"
                               ng-model="cFirstName"
                               required
                               ng-blur="markBookingFieldTouched('cFirstName')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cFirstName')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cFirstName')">{{ getBookingFieldErrorMessage('cFirstName') }}</p>
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Client's Lastname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cLastName"
                               ng-model="cLastName"
                               required
                               ng-blur="markBookingFieldTouched('cLastName')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cLastName')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cLastName')">{{ getBookingFieldErrorMessage('cLastName') }}</p>
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Email <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="E-mail"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cEmail"
                               ng-model="cEmail"
                               required
                               ng-blur="markBookingFieldTouched('cEmail')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cEmail')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cEmail')">{{ getBookingFieldErrorMessage('cEmail') }}</p>
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Contact Number <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="11"
                               placeholder="Contact Number e.g 09*********"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cContactNum"
                               ng-model="cContactNum"
                               required
                               ng-blur="markBookingFieldTouched('cContactNum')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cContactNum')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cContactNum')">{{ getBookingFieldErrorMessage('cContactNum') }}</p>
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Celebrant's Firstname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb1FirstName"
                               ng-model="cCeleb1FirstName"
                               required
                               ng-blur="markBookingFieldTouched('cCeleb1FirstName')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cCeleb1FirstName')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cCeleb1FirstName')">{{ getBookingFieldErrorMessage('cCeleb1FirstName') }}</p>
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Celebrant's Lastname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb1LastName"
                               ng-model="cCeleb1LastName"
                               required
                               ng-blur="markBookingFieldTouched('cCeleb1LastName')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('cCeleb1LastName')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('cCeleb1LastName')">{{ getBookingFieldErrorMessage('cCeleb1LastName') }}</p>
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            2nd Celebrant's Firstname 
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb2FirstName"
                               ng-model="cCeleb2FirstName">
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            2nd Celebrant's Lastname 
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb2LastName"
                               ng-model="cCeleb2LastName">
                    </div>

                    <br>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Venue <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="venue"
                               placeholder="Venue Address"
                               ng-model="eventVenue"
                               required
                               ng-blur="markBookingFieldTouched('eventVenue')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventVenue')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventVenue')">{{ getBookingFieldErrorMessage('eventVenue') }}</p>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Preparation Venue <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="prepVenue"
                               placeholder="Preparation Venue Address"
                               ng-model="eventPrepVenue"
                               required
                               ng-blur="markBookingFieldTouched('eventPrepVenue')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventPrepVenue')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventPrepVenue')">{{ getBookingFieldErrorMessage('eventPrepVenue') }}</p>
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Motif <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Disney"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-model="eventMotif"
                               name="motif"
                               required
                               ng-blur="markBookingFieldTouched('eventMotif')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventMotif')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventMotif')">{{ getBookingFieldErrorMessage('eventMotif') }}</p>
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Theme <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Disney"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-model="eventTheme"
                               name="theme"
                               required
                               ng-blur="markBookingFieldTouched('eventTheme')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventTheme')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventTheme')">{{ getBookingFieldErrorMessage('eventTheme') }}</p>
                    </div>

                    <br>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Date of Event <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="date"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-change="changeSummaryDateOutput()"
                               ng-model="dateOfEvent"
                               name="dateOfEvent"
                               required
                               ng-blur="markBookingFieldTouched('dateOfEvent')"
                               ng-class="{'booking-field-invalid': shouldShowBookingFieldError('dateOfEvent')}">
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('dateOfEvent')">{{ getBookingFieldErrorMessage('dateOfEvent') }}</p>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Ceremony Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventCeremTime'); toggleDropdown('ceremHour', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventCeremTime')}">
                                    {{ceremHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectCeremHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventCeremTime'); toggleDropdown('ceremMin', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventCeremTime')}">
                                    {{ceremMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectCeremMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventCeremTime'); toggleDropdown('ceremPer', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventCeremTime')}">
                                    {{ceremPeriod || 'AM/PM'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremPer'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="p in periods"
                                         ng-click="selectCeremPeriod(p)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremPeriod===p}">
                                        {{p}}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="booking-error" ng-if="shouldShowBookingFieldError('eventCeremTime')">{{ getBookingFieldErrorMessage('eventCeremTime') }}</p>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventEventTime'); toggleDropdown('eventHour', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventEventTime')}">
                                    {{eventHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='eventHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectEventHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventEventTime'); toggleDropdown('eventMin', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventEventTime')}">
                                    {{eventMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='eventMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectEventMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="markBookingFieldTouched('eventEventTime'); toggleDropdown('eventPer', $event)"
                                        ng-class="{'booking-field-invalid': shouldShowBookingFieldError('eventEventTime')}">
                                    {{eventPeriod || 'AM/PM'}}
