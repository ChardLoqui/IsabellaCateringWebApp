@{
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Create Booking";
}

<div class="bg-gray-50" ng-init="authenticateLoginCredentials()">
    <div class="flex min-h-screen w-full items-center justify-center p-4">

        <form name="eventForm" ng-submit="bookEvent()" novalidate>

            <div class="flex w-full max-w-5xl flex-col rounded-2xl border bg-white shadow-xl">



                <div class="grid w-full grid-cols-1 gap-6 px-6 py-8 sm:px-8 md:grid-cols-3 md:px-12" ng-init="loadPackageOptions()">


                    <h1 class="font-heading col-span-3 my-2 text-2xl sm:text-3xl md:text-4xl md:col-span-3">
                        <span class="underline decoration-pink-500 decoration-4 underline-offset-4">
                            Book
                        </span> Your Event
                    </h1>


                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Name <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Isabella's Debut"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="eventName"
                               ng-model="eventName">
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Package <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('packageTypesOpt', $event)"
                                   ng-value="getPackageDisplayText()" />
                            <div ng-if="activeDropdown ==='packageTypesOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="package in packageTypesOpt"
                                     ng-click="selectPackageTypes(package.packageTypDesc, package.packageTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': packageType===package.packageTypDesc}">
                                    {{package.packageTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Type
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('eventsOpt', $event)"
                                   ng-value="getEventDisplayText()" />
                            <div ng-if="activeDropdown ==='eventsOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="event in eventsOpt"
                                     ng-click="selectEventTypes(event.eventDesc, event.eventID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventType===event.eventDesc}">
                                    {{event.eventDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Client's Firstname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cFirstName"
                               ng-model="cFirstName">
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Client's Lastname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cLastName"
                               ng-model="cLastName">
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Email <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="E-mail"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cEmail"
                               ng-model="cEmail">
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Contact Number <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="11"
                               placeholder="Contact Number e.g 09*********"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cContactNum"
                               ng-model="cContactNum">
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Celebrant's Firstname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb1FirstName"
                               ng-model="cCeleb1FirstName">
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Celebrant's Lastname <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb1LastName"
                               ng-model="cCeleb1LastName">
                    </div>

                    <br>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            2nd Celebrant's Firstname 
                        </label>
                        <input type="text"
                               placeholder="Firstname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb2FirstName"
                               ng-model="cCeleb2FirstName">
                    </div>

                    <div class="col-span-2 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            2nd Celebrant's Lastname 
                        </label>
                        <input type="text"
                               placeholder="Lastname"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="cCeleb2LastName"
                               ng-model="cCeleb2LastName">
                    </div>

                    <br>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Venue <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="venue"
                               placeholder="Venue Address"
                               ng-model="eventVenue">
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Preparation Venue <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               name="prepVenue"
                               placeholder="Preparation Venue Address"
                               ng-model="eventPrepVenue">
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Motif <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Disney"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-model="eventMotif"
                               name="motif">
                    </div>


                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Theme <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="text"
                               placeholder="e.g Disney"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-model="eventTheme"
                               name="theme">
                    </div>

                    <br>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Date of Event <i class="font-label text-red-500">*</i>
                        </label>
                        <input type="date"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-change="changeSummaryDateOutput()"
                               ng-model="dateOfEvent" name="dateOfEvent">
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Ceremony Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('ceremHour', $event)">
                                    {{ceremHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectCeremHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('ceremMin', $event)">
                                    {{ceremMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectCeremMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('ceremPer', $event)">
                                    {{ceremPeriod || 'AM/PM'}}
                                </button>
                                <div ng-if="activeDropdown ==='ceremPer'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="p in periods"
                                         ng-click="selectCeremPeriod(p)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': ceremPeriod===p}">
                                        {{p}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Event Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('eventHour', $event)">
                                    {{eventHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='eventHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectEventHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('eventMin', $event)">
                                    {{eventMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='eventMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectEventMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('eventPer', $event)">
                                    {{eventPeriod || 'AM/PM'}}
                                </button>
                                <div ng-if="activeDropdown ==='eventPer'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

                                    <div ng-repeat="p in periods"
                                         ng-click="selectEventPeriod(p)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': eventPeriod===p}">
                                        {{p}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Meal Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('mealHour', $event)">
                                    {{mealHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='mealHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectMealHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': mealHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('mealMin', $event)">
                                    {{mealMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='mealMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectMealMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': mealMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('mealPer', $event)">
                                    {{mealPeriod || 'AM/PM'}}
                                </button>
                                <div ng-if="activeDropdown ==='mealPer'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

                                    <div ng-repeat="p in periods"
                                         ng-click="selectMealPeriod(p)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': mealPeriod===p}">
                                        {{p}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Set Time <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('setHour', $event)">
                                    {{setHour || 'Hour'}}
                                </button>
                                <div ng-if="activeDropdown ==='setHour'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="h in hours"
                                         ng-click="selectSetHour(h)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': setHour===h}">
                                        {{h}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('setMin', $event)">
                                    {{setMinute || 'Min'}}
                                </button>
                                <div ng-if="activeDropdown ==='setMin'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                    <div ng-repeat="m in minutes"
                                         ng-click="selectSetMinute(m)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': setMinute===m}">
                                        {{m}}
                                    </div>
                                </div>
                            </div>
                            <div class="relative dropdown-container">
                                <button type="button"
                                        class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                        ng-click="toggleDropdown('setPer', $event)">
                                    {{setPeriod || 'AM/PM'}}
                                </button>
                                <div ng-if="activeDropdown ==='setPer'" ng-click="$event.stopPropagation()"
                                     class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

                                    <div ng-repeat="p in periods"
                                         ng-click="selectSetPeriod(p)"
                                         class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                         ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': setPeriod===p}">
                                        {{p}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <br>

