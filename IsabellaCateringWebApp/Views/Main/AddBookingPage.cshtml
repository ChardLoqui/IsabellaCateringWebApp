                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('entranceOpt', $event)"
                                   ng-value="getEntranceDisplayText()" />
                            <div ng-if="activeDropdown ==='entranceOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="entrance in entranceTypesOpt"
                                     ng-click="selectEntranceType(entrance.entranceTypDesc, entrance.entranceTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': entranceType===entrance.entranceTypDesc}">
                                    {{entrance.entranceTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Celebrant's Couch <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('couchOpt', $event)"
                                   ng-value="getCouchDisplayText()" />
                            <div ng-if="activeDropdown ==='couchOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="couch in couchTypesOpt"
                                     ng-click="selectCouchType(couch.couchTypDesc, couch.couchTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': couchType===couch.couchTypDesc}">
                                    {{couch.couchTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Equipments & Decor <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('equipOpt', $event)"
                                   ng-value="getEquipDisplayText()" />
                            <div ng-if="activeDropdown ==='equipOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="equip in equipTypesOpt"
                                     ng-click="toggleEquipType(equip.equipTypDesc, equip.equipTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': isEquipSelected(equip.equipTypDesc)}">
                                    {{equip.equipTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Entertainment <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('entertainmentOpt', $event)"
                                   ng-value="getEntertainmentDisplayText()" />
                            <div ng-if="activeDropdown ==='entertainmentOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="entertainment in entertainmentTypesOpt"
                                     ng-click="toggleEntertainmentType(entertainment.entertainmentTypDesc, entertainment.entertainmentTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': isEntertainmentSelected(entertainment.entertainmentTypDesc)}">
                                    {{entertainment.entertainmentTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Photo Operations <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('photoOpt', $event)"
                                   ng-value="getPhotoDisplayText()" />
                            <div ng-if="activeDropdown ==='photoOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="photo in photoTypesOpt"
                                     ng-click="togglePhotoType(photo.photoTypDesc, photo.photoTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': isPhotoSelected(photo.photoTypDesc)}">
                                    {{photo.photoTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Keepsakes <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('keepsakesOpt', $event)"
                                   ng-value="getKeepsakesDisplayText()" />
                            <div ng-if="activeDropdown ==='keepsakesOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="keepsakes in keepsakesTypesOpt"
                                     ng-click="toggleKeepsakesType(keepsakes.keepsakesTypDesc, keepsakes.keepsakesTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': isKeepsakesSelected(keepsakes.keepsakesTypDesc)}">
                                    {{keepsakes.keepsakesTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Debut Additionals <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text" ng-disabled="addDebutInput"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('debutOpt', $event)"
                                   ng-value="getDebutDisplayText()" />
                            <div ng-if="activeDropdown ==='debutOpt'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="debut in debutTypesOpt"
                                     ng-click="toggleDebutType(debut.debutTypDesc, debut.debutTypID)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': isDebutSelected(debut.debutTypDesc)}">
                                    {{debut.debutTypDesc}}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-span-full create-booking-actions pt-2">
                        <div class="create-booking-actions__meta">
                            Step 1 of 3
                        </div>
                        <button type="button"
                                ng-click="goToNextBookingStep()"
                                class="create-booking-submit inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Continue to Summary
                        </button>
                    </div>
                    </div>

                    <div class="contents" ng-show="bookingStep === 2">
                    <div class="create-booking-section col-span-3">
                        <h2 class="text-xl font-semibold text-zinc-950 sm:text-2xl">Package Summary</h2>
                        <p class="mt-2 text-sm leading-6 text-zinc-500">
                            Review the booking details here. If anything looks off, return to the previous step and update it there.
                        </p>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <div class="create-booking-summary relative">
                            <label class="font-label mb-1 text-sm font-bold text-gray-400 md:text-base">
                                Client Information
                            </label>
                            <ul>
                                <li><b>Client's Name:</b> {{cFirstName || "-"}} {{cLastName}}</li>
                                <li><b>Email:</b> {{cEmail || "-"}}</li>
                                <li><b>Contact Number:</b> {{cContactNum || "-"}}</li>
                                <li><b>Celebrant's Name</b> {{cCeleb1FirstName || "-"}} {{cCeleb1LastName}}</li>
                                <li><b>2nd Celebrant's Name:</b> {{cCeleb2FirstName || "-"}} {{cCeleb2LastName}}</li>
                            </ul>
                            <br>
                            <label class="font-label mb-1 text-sm font-bold text-gray-400 md:text-base">
                                Booking Information
                            </label>
                            <ul>
                                <li><b>Event Name:</b> {{eventName || "-"}}</li>
                                <li><b>Package Type:</b> {{packageType || "-"}}</li>
                                <li><b>Event Type:</b> {{eventType || "-"}}</li>
                                <li><b>Venue:</b> {{eventVenue || "-"}}</li>
                                <li><b>Preparation Venue:</b> {{eventPrepVenue || "-"}}</li>
                                <li><b>Motif:</b> {{eventMotif || "-"}}</li>
                                <li><b>Theme:</b> {{eventTheme || "-"}}</li>
                                <li><b>Date of Event:</b> {{formattedDateOfEvent || "No Date"}}</li>
                                <li><b>Ceremony Time:</b> {{ceremHour || "00"}}:{{ceremMin || "00"}} {{ceremPeriod}} ({{eventCeremTime || "-"}})</li>
                                <li><b>Event Time:</b> {{eventHour || "00"}}:{{eventMin || "00"}} {{eventPeriod}} ({{eventEventTime || "-"}})</li>
                                <li><b>Meal Time:</b> {{mealHour || "00"}}:{{mealMin || "00"}} {{mealPeriod}} ({{eventMealTime || "-"}})</li>
                                <li><b>Set Time:</b> {{setHour || "00"}}:{{setMin || "00"}} {{setPeriod}} ({{eventSetTime || "-"}})</li>
                            </ul>
                            <br>
                            <label class="font-label mb-1 text-sm font-bold text-gray-400 md:text-base">
                                Package Inclusion
                            </label>
                            <ul>
                                <li><b>Main Courses:</b> {{mainCourseType || "-"}}</li>
                                <li><b>Sides & Dessert:</b> {{sidesType || "-"}}</li>
                                <li><b>Staples & Drinks:</b> {{staplesType || "-"}}</li>
                                <li><b>Buffet Setup:</b> {{buffetType || "-"}}</li>
                                <li><b>Styling:</b> {{stylingType || "-"}}</li>
                                <li><b>Table Setup:</b> {{tableType || "-"}}</li>
                                <li><b>Table Centerpiece:</b> {{centerPieceType || "-"}}</li>
                                <li><b>Seating:</b> {{seatingType || "-"}}</li>
                                <li><b>Special Tables:</b> {{specialsType || "-"}}</li>
                                <li><b>Staff:</b> {{staffType || "-"}}</li>
                                <li><b>Dinerware:</b> {{dinerwareType || "-"}}</li>
                                <li><b>Backdrop:</b> {{backdropType || "-"}}</li>
                                <li><b>Entrance Arch:</b> {{entranceType || "-"}}</li>
                                <li><b>Celebrant's Couch:</b> {{couchType || "-"}}</li>
                                <li><b>Equipments & Decor:</b> {{equipType || "-"}}</li>
                                <li><b>Entertainment:</b> {{entertainmentType || "-"}}</li>
                                <li><b>Photo Operations:</b> {{photoType || "-"}}</li>
                                <li><b>Keepsakes:</b> {{keepsakesType || "-"}}</li>
                                <li><b>Debut Additionals:</b> {{debutType || "-"}}</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-span-full create-booking-actions pt-2">
                        <button type="button"
                                ng-click="goToPreviousBookingStep()"
                                class="create-booking-secondary inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Back to Details
                        </button>
                        <div class="create-booking-actions__meta">
                            Step 2 of 3
                        </div>
                        <button type="button"
                                ng-click="goToNextBookingStep()"
                                class="create-booking-submit inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Continue to Pricing
                        </button>
                    </div>
                    </div>

                    <div class="contents" ng-show="bookingStep === 3">
                    <div class="create-booking-section col-span-3">
                        <h2 class="text-xl font-semibold text-zinc-950 sm:text-2xl">Pricing &amp; Confirmation</h2>
                        <p class="mt-2 text-sm leading-6 text-zinc-500">
                            Finalize guest count, adjust add-ons, and confirm the booking amount before submission.
                        </p>
                    </div>
                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Guest Count <i class="font-label text-red-500">*</i>
                        </label>
                        <div class="relative dropdown-container">
                            <input type="text"
                                   class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-left text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
                                   readonly
                                   ng-click="toggleDropdown('pricePax', $event)"
                                   ng-value="getPricePaxDisplayText()" />
                            <div ng-if="activeDropdown ==='pricePax'" ng-click="$event.stopPropagation()"
                                 class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                                <div ng-repeat="price in pricePaxOpt"
                                     ng-click="selectPricePaxType(price.pricePaxID, price.pricePaxDesc, price.pricePaxPrice)"
                                     class="px-3 py-2 cursor-pointer hover:bg-pink-100"
                                     ng-class="{'bg-pink-300 border border-pink-500 rounded-lg': priceType===price.pricePaxDesc}">
                                    {{price.pricePaxDesc}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <div class="grid grid-cols-2 gap-2">
                            <div class="col-span-3 flex flex-col md:col-span-1">
                                <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                                    Adult Additional
                                </label>
                                <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="3"
                                       placeholder="Adult Count"
                                       class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                                       ng-change="computeFinalPrice()"
                                       ng-model="addAdult"
                                       name="adult">
                            </div>
                            <div class="col-span-3 flex flex-col md:col-span-1">
                                <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                                    Kid Additional
                                </label>
                                <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="3" ng-disabled="addKdInput"
                                       placeholder="Kid Count"
                                       class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                                       ng-change="computeFinalPrice()"
                                       ng-model="addKid"
                                       name="kid">
                            </div>
                        </div>
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-1">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Final Price
                        </label>
                        <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="11"
                               placeholder="Final Price"
                               class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                               ng-model="bookingFinalPrice"
                               name="finalPrice">
                    </div>

                    <div class="col-span-3 flex flex-col md:col-span-3">
                        <label class="font-label mb-1 text-sm font-bold text-gray-600 sm:text-base">
                            Booking Note
                        </label>
                        <textarea class="w-full h-auto max-h-40 rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 sm:text-base"
                                  name="bookingNote"
                                  placeholder="Add Note Here..."
                                  ng-model="bookingNote">
                        </textarea>
                    </div>

                    <!-- Button -->
                    <div class="col-span-full create-booking-actions pt-2">
                        <button type="button"
                                ng-click="goToPreviousBookingStep()"
                                class="create-booking-secondary inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Back to Summary
                        </button>

                        <div class="create-booking-actions__meta">
                            Step 3 of 3
                        </div>

                        <button type="button" ng-if="!isEditMode" ng-click="createBooking()" class="create-booking-submit inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Book Event
                        </button>

                        <button type="button" ng-if="isEditMode" ng-click="editBooking()" class="create-booking-submit inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Update Event
                        </button>

                        <button type="button" ng-if="isEditMode" ng-click="deleteBooking()" class=" bg-gray-400 hover:bg-gray-500 border-gray-200 hover:border-gray-300 create-booking-submit inline-flex w-full cursor-pointer items-center justify-center px-5 py-3 text-sm font-semibold sm:w-auto sm:min-w-[220px]">
                            Delete Event
                        </button>
                    </div>
                    </div>

                </div>
                    </section>
                </form>
            </div>
        </div>
    </div>
</section>
