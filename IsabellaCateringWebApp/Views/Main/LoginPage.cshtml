@{
    Layout = "~/Views/Shared/_LogInLayout.cshtml";
    ViewBag.Title = "Log In";
}

<div ng-init="authenticateLoginLoginCredentials()" class="login-shell min-h-screen">
    <div class="login-shell-main grid min-h-screen w-full lg:grid-cols-[60%_40%]">
        <section class="login-showcase relative hidden lg:block">
            <div class="login-carousel-shell">
                <div id="default-carousel" class="absolute inset-0 h-full w-full" data-carousel="slide">
                    <div class="relative h-full overflow-hidden">
                        <div class="duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img1.jpg" class="h-full w-full object-cover" alt="Elegant catering setup">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img2.jpg" class="h-full w-full object-cover" alt="Styled event venue">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img3.jpg" class="h-full w-full object-cover" alt="Signature dining arrangement">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img4.jpg" class="h-full w-full object-cover" alt="Celebration table styling">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img5.jpg" class="h-full w-full object-cover" alt="Refined event presentation">
                        </div>
                    </div>

                    <div class="absolute bottom-10 left-10 z-20">
                        <div class="login-progress" id="loginCarouselProgress" data-carousel-indicators aria-label="Carousel progress">
                            <button type="button" class="login-progress-btn" aria-current="true" data-carousel-slide-to="0" aria-label="Slide 1"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="2" aria-label="Slide 3"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="3" aria-label="Slide 4"></button>
                            <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="4" aria-label="Slide 5"></button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-auth-panel flex min-h-screen items-center justify-center px-6 py-10 sm:px-10 lg:px-14">
            <div class="login-form-shell">
                <div class="login-fade relative flex flex-col items-center justify-center text-center">
                    <div class="login-brand-lockup absolute left-1/2 top-[-4.75rem] flex -translate-x-1/2 items-center justify-center gap-3 whitespace-nowrap">
                        <img src="~/Content/images/isabellaLogo.jpg" alt="Isabella Catering and Events Logo" class="h-32 w-32 rounded-lg object-cover">
                    </div>
                    <br />
                    <br />
                    <br />
                    <h1 class="login-header text-lg font-semibold uppercase text-pink-700/85">Isabella Catering</h1>
                    <h2 class="mt-2 text-4xl font-semibold tracking-tight text-zinc-950">Welcome Back</h2>
                    <p class="mt-8 text-sm text-pink-700/70">Login by entering your credentials</p>
                </div>

                <form class="mt-8 space-y-5" name="loginForm" ng-submit="logInService()" novalidate>
                    <div class="login-fade-delayed login-field-group">
                        <div class="mb-2 flex items-center justify-between">
                            <label for="logEmail" class="login-label text-sm font-medium text-zinc-800">
                                <span>{{isGuest ? 'Entry Code' : 'Email'}}</span
                                <span class="login-required">*</span>
                            </label>
                            <small id="emailCount" class="login-meta">0 / 50</small>
                        </div>

                        <div class="relative">
                            <input id="logEmail"
                                   name="loginIdentifier"
                                   ng-model="lEmail"
                                   type="text"
                                   required
                                   maxlength="50"
                                   ng-pattern="isGuest ? guestCodePattern : emailPattern"
                                   oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('emailCount').innerText = this.value.length + ' / 50';"
                                   ng-class="{'login-field-invalid': shouldShowFieldError(loginForm, 'loginIdentifier')}"
                                   class="login-field w-full rounded-lg bg-white px-4 py-3 text-zinc-900 placeholder-zinc-400 outline-none"
                                   placeholder="{{emailPlaceholder || 'Use Email'}}" />
                        </div>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(loginForm, 'loginIdentifier', 'required')">
                            {{isGuest ? 'Entry code is required.' : 'Email is required.'}}
                        </p>
                        <p class="login-error"
                           ng-if="!isGuest && shouldShowFieldError(loginForm, 'loginIdentifier', 'pattern')">
                            Enter a valid email address.
                        </p>
                    </div>

                    <div class="login-fade-delayed flex items-center">
                        <label class="flex cursor-pointer items-center gap-3 text-sm font-medium text-zinc-700">
                            <input type="checkbox"
                                   ng-model="isGuest"
                                   ng-change="changeCredPlaceholder()"
                                   class="h-4 w-4 rounded border-pink-200 bg-white text-pink-500 accent-pink-500 focus:ring-pink-400" />
                            <span>Login as Guest</span>
                        </label>
                    </div>

                    <div class="login-fade-delayed login-field-group">
                        <div class="mb-2 flex items-center justify-between">
                            <label for="logPWord" class="login-label text-sm font-medium text-zinc-800">
                                <span>Password</span>
                                <span class="login-required">*</span>
                            </label>
                            <small id="passCount" class="login-meta">0 / 20</small>
                        </div>

                        <div class="relative">
                            <input id="logPWord"
                                   name="loginPassword"
                                   ng-model="lPassword"
                                   type="password"
                                   required
                                   maxlength="20"
                                   oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('passCount').innerText = this.value.length + ' / 20'; document.getElementById('toggleLogInPassword').style.display = this.value.length ? 'block' : 'none';"
                                   ng-class="{'login-field-invalid': shouldShowFieldError(loginForm, 'loginPassword')}"
                                   class="login-field w-full rounded-lg bg-white px-4 py-3 pr-14 text-zinc-900 placeholder-zinc-400 outline-none"
                                   placeholder="Enter your password" />

                            <span id="toggleLogInPassword" ng-click="toggleShowLogInPassword()"
                                  class="material-icons absolute w-7 right-3 top-1/2 hidden -translate-y-1/2 cursor-pointer text-gray-500 select-none">
                                visibility_off
                            </span>
                        </div>
                        <p class="login-error"
                           ng-if="shouldShowFieldError(loginForm, 'loginPassword', 'required')">
                            Password is required.
                        </p>
                    </div>

                    <div class="login-fade-delayed flex items-center justify-between gap-4 text-sm">
                        <label class="flex items-center gap-3 text-zinc-700">
                            <input type="checkbox"
                                   class="h-4 w-4 rounded border-pink-200 bg-white text-pink-500 accent-pink-500 focus:ring-pink-400" />
                            <span>Remember me</span>
                        </label>
                        <button type="button"
                                ng-click="redirectToForgetPassPage()"
                                class="font-medium text-pink-700 transition hover:text-pink-800">
                            Forgot password?
                        </button>
                    </div>

                    <button type="submit"
                            class="login-submit login-fade-delayed w-full rounded-lg bg-pink-500 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-pink-900/10 hover:bg-pink-600">
                        Log in
                    </button>

                    <div class="mt-6 text-center text-sm">
                        <p class="text-gray-500">Interested in our services?</p>
                        <a href="@Url.Action("LandingPage", "Main")" class="mt-1 inline-block font-semibold text-pink-600 hover:text-pink-700 transition-colors">
                            View our Event Packages
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>
