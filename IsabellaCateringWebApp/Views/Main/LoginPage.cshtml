@{
    Layout = "~/Views/Shared/_LogInLayout.cshtml";
    ViewBag.Title = "Log In";
}

<style>
    .login-shell,
    .login-shell input,
    .login-shell button,
    .login-shell label,
    .login-shell small,
    .login-shell p {
        font-family: "Montserrat", sans-serif;
    }

    .login-shell h1,
    .login-shell h2 {
        font-family: "Josefin Sans", sans-serif;
    }

    .login-shell {
        background:
            radial-gradient(circle at top left, rgba(255, 255, 255, 0.4), transparent 22%),
            linear-gradient(135deg, #f7d3e3 0%, #f5cade 42%, #f2c0d9 100%);
    }

    .login-showcase::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(24, 24, 27, 0.08) 0%, rgba(24, 24, 27, 0.26) 100%);
    }

    .login-showcase::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
            linear-gradient(135deg, rgba(236, 72, 153, 0.22) 0%, rgba(244, 114, 182, 0.12) 42%, rgba(252, 211, 231, 0.04) 100%);
    }

    .login-carousel-shell {
        position: absolute;
        inset: 0;
        overflow: hidden;
        border-radius: 0;
    }

    .login-fade {
        animation: loginFade 0.65s ease-out both;
    }

    .login-fade-delayed {
        animation: loginFade 0.85s ease-out both;
    }

    .login-field {
        transition: box-shadow 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .login-field:focus {
        box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.14);
        background-color: #ffffff;
        transform: translateY(-1px);
    }

    .login-submit {
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .login-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(190, 24, 93, 0.18);
    }

    .login-progress {
        display: flex;
        gap: 0.5rem;
        padding: 0.625rem 0.75rem;
        border-radius: 9999px;
        background: rgba(24, 24, 27, 0.45);
        box-shadow: 0 10px 30px rgba(24, 24, 27, 0.2);
        backdrop-filter: blur(8px);
    }

    .login-progress-btn {
        height: 4px;
        width: 2.75rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.45);
        overflow: hidden;
    }

    .login-progress-fill {
        height: 100%;
        width: 0;
        background: #ffffff;
        transition: width 0.35s ease, opacity 0.35s ease;
    }

    .login-progress-btn.is-active .login-progress-fill {
        width: 100%;
    }

    .login-header {
        letter-spacing: 0.22em;
    }

    @@keyframes loginFade {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController" class="login-shell min-h-screen">
    <div class="grid min-h-screen w-full lg:grid-cols-[60%_40%]">
            <section class="login-showcase relative hidden lg:block">
                <div class="login-carousel-shell">
                    <div id="default-carousel" class="absolute inset-0 h-full w-full" data-carousel="slide">
                    <div class="relative h-full overflow-hidden">
                        <div class="duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img1.jpg" class="h-full w-full object-cover" alt="Elegant catering setup">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img2.jpg" class="h-full w-full object-cover" alt="Styled event venue">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img3.jpg" class="h-full w-full object-cover" alt="Signature dining arrangement">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img4.jpg" class="h-full w-full object-cover" alt="Celebration table styling">
                        </div>
                        <div class="hidden duration-700 ease-in-out" data-carousel-item>
                            <img src="/Content/images/img5.jpg" class="h-full w-full object-cover" alt="Refined event presentation">
                        </div>
                    </div>

                    <div class="absolute bottom-8 left-8 z-20">
                        <div class="login-progress" id="loginCarouselProgress" aria-label="Carousel progress">
                            <button type="button" class="login-progress-btn is-active" data-carousel-slide-to="0" aria-label="Slide 1">
                                <span class="login-progress-fill"></span>
                            </button>
                            <button type="button" class="login-progress-btn" data-carousel-slide-to="1" aria-label="Slide 2">
                                <span class="login-progress-fill"></span>
                            </button>
                            <button type="button" class="login-progress-btn" data-carousel-slide-to="2" aria-label="Slide 3">
                                <span class="login-progress-fill"></span>
                            </button>
                            <button type="button" class="login-progress-btn" data-carousel-slide-to="3" aria-label="Slide 4">
                                <span class="login-progress-fill"></span>
                            </button>
                            <button type="button" class="login-progress-btn" data-carousel-slide-to="4" aria-label="Slide 5">
                                <span class="login-progress-fill"></span>
                            </button>
                        </div>
                    </div>
                </div>
                </div>
            </section>

            <section class="flex min-h-screen items-center justify-center bg-[#fcd1e5] px-6 py-10 sm:px-10 lg:px-14">
                <div class="w-full max-w-md">
                    <div class="login-fade relative flex flex-col items-center justify-center text-center">
                        <div class="absolute left-1/2 top-[-7.5rem] flex -translate-x-1/2 items-center justify-center gap-3 whitespace-nowrap">
                            <img src="~/Content/images/isabellaLogo.jpg" alt="Isabella Catering and Events Logo" class="h-12 w-12 rounded-lg object-cover">
                            <h1 class="login-header text-lg font-semibold uppercase text-rose-700/85">Isabella Catering</h1>
                        </div>
                        <h2 class="mt-2 text-4xl font-semibold tracking-tight text-zinc-950">Welcome Back</h2>
                        <p class="mt-8 text-sm text-rose-700/70">Login by entering your credentials</p>
                    </div>

                    <div class="login-fade-delayed mt-8">
                        <div class="flex flex-col">
                            <div class="mb-2 flex items-center justify-between">
                                <label for="logEmail" class="text-sm font-medium text-zinc-800">Email</label>
                                <small id="emailCount" class="text-xs text-zinc-400">0 / 50</small>
                            </div>

                            <div class="relative">
                                <input id="logEmail"
                                       ng-model="lEmail"
                                       type="email"
                                       required
                                       maxlength="50"
                                       oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('emailCount').innerText = this.value.length + ' / 50';"
                                       class="login-field w-full rounded-lg bg-white px-4 py-3 text-zinc-900 placeholder-zinc-400 outline-none"
                                       placeholder="Enter your email" />
                            </div>
                        </div>
                    </div>

                    <form class="mt-5 space-y-5" name="loginForm" novalidate>
                        <div class="login-fade-delayed flex flex-col">
                            <div class="mb-2 flex items-center justify-between">
                                <label for="logPWord" class="text-sm font-medium text-zinc-800">Password</label>
                                <small id="passCount" class="text-xs text-zinc-400">0 / 20</small>
                            </div>

                            <div class="relative">
                                <input id="logPWord"
                                       ng-model="lPassword"
                                       type="password"
                                       required
                                       maxlength="20"
                                       oninput="this.value = this.value.replace(/\s/g, ''); document.getElementById('passCount').innerText = this.value.length + ' / 20';"
                                       class="login-field w-full rounded-lg bg-white px-4 py-3 pr-12 text-zinc-900 placeholder-zinc-400 outline-none"
                                       placeholder="Enter your password" />

                                <span id="toggleLogInPassword"
                                      ng-click="toggleShowLogInPassword()"
                                      ng-show="lPassword && lPassword.length > 0"
                                      class="material-icons absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer select-none text-zinc-400 transition hover:text-zinc-700">
                                    visibility_off
                                </span>
                            </div>
                        </div>

                        <div class="login-fade-delayed flex items-center justify-between gap-4 text-sm">
                            <label class="flex items-center gap-3 text-zinc-700">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-rose-200 bg-white text-rose-500 accent-rose-500 focus:ring-rose-400" />
                                <span>Remember me</span>
                            </label>
                            <button type="button"
                                    ng-click="redirectToForgetPassPage()"
                                    class="font-medium text-rose-700 transition hover:text-rose-800">
                                Forgot password?
                            </button>
                        </div>

                        <button type="submit"
                                ng-click="logInService()"
                                class="login-submit login-fade-delayed w-full rounded-lg bg-rose-500 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-rose-900/10 hover:bg-rose-600">
                            Log in
                        </button>
                    </form>
                </div>
            </section>
    </div>
</div>

<script>
    (function () {
        var progressButtons = Array.prototype.slice.call(document.querySelectorAll('#loginCarouselProgress .login-progress-btn'));
        if (!progressButtons.length) {
            return;
        }

        function setActiveProgress(activeIndex) {
            progressButtons.forEach(function (button, index) {
                button.classList.toggle('is-active', index === activeIndex);
            });
        }

        progressButtons.forEach(function (button, index) {
            button.addEventListener('click', function () {
                setActiveProgress(index);
            });
        });

        var observer = new MutationObserver(function () {
            var items = Array.prototype.slice.call(document.querySelectorAll('#default-carousel [data-carousel-item]'));
            var activeIndex = items.findIndex(function (item) {
                return !item.classList.contains('hidden');
            });

            if (activeIndex >= 0) {
                setActiveProgress(activeIndex);
            }
        });

        document.querySelectorAll('#default-carousel [data-carousel-item]').forEach(function (item) {
            observer.observe(item, { attributes: true, attributeFilter: ['class'] });
        });
    })();
</script>
