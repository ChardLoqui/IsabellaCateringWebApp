@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Log In";

    <body ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController" class="login-shell">

        <div class="flex h-screen w-full">
            <!-- Left side -->
            <div class="w-1/2 flex items-center justify-center">

                <div class="w-1/2 h-full w-full">
                    <div id="default-carousel" class="relative w-full h-full" data-carousel="slide">
                        <!-- Carousel wrapper -->
                        <div class="relative h-full overflow-hidden">
                            <!-- Item 1 -->
                            <div class="duration-700 ease-in-out" data-carousel-item>
                                <img src="/Content/images/img1.jpg"
                                     class="w-full h-full object-cover"
                                     alt="Slide 1">
                            </div>

                            <!-- Item 2 -->
                            <div class="hidden duration-700 ease-in-out" data-carousel-item>
                                <img src="/Content/images/img2.jpg"
                                     class="w-full h-full object-cover"
                                     alt="Slide 2">
                            </div>

                            <!-- Item 3 -->
                            <div class="hidden duration-700 ease-in-out" data-carousel-item>
                                <img src="/Content/images/img3.jpg"
                                     class="w-full h-full object-cover"
                                     alt="Slide 3">
                            </div>
                            <!-- Item 4 -->
                            <div class="hidden duration-700 ease-in-out" data-carousel-item>
                                <img src="/Content/images/img4.jpg"
                                     class="w-full h-full object-cover"
                                     alt="Slide 3">
                            </div>
                            <!-- Item 5 -->
                            <div class="hidden duration-700 ease-in-out" data-carousel-item>
                                <img src="/Content/images/img5.jpg"
                                     class="w-full h-full object-cover"
                                     alt="Slide 3">
                            </div>
                        </div>

                        <!-- Indicators -->
                        <div class="absolute z-30 flex -translate-x-1/2 bottom-10 left-1/2">
                            <div class="login-progress" id="loginCarouselProgress" data-carousel-indicators>
                                <button type="button" class="login-progress-btn" aria-current="true" data-carousel-slide-to="0"></button>
                                <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="1"></button>
                                <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="2"></button>
                                <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="3"></button>
                                <button type="button" class="login-progress-btn" aria-current="false" data-carousel-slide-to="4"></button>
                            </div>
                        </div>

                        <!-- Controls -->
                        <button class="absolute top-0 left-0 z-30 flex items-center justify-center h-full px-4"
                                data-carousel-prev>
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30">
                                <span class="material-icons text-white text-2xl">
                                    chevron_left
                                </span>
                            </span>
                        </button>

                        <button class="absolute top-0 right-0 z-30 flex items-center justify-center h-full px-4"
                                data-carousel-next>
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30">
                                <span class="material-icons text-white text-2xl">
                                    chevron_right
                                </span>
                            </span>
                        </button>

                    </div>
                </div>

            </div>

            <!-- Right side -->
            <div class="auth-side-panel w-1/2 flex items-center justify-center">
                <form class="w-3/4 max-w-md space-y-5">

                    <!-- Header -->
                    <header class="text-center">
                        <img src="~/Content/images/isabellaLogo.jpg" alt="Isabella Catering and Events Logo" class="w-52 h-auto mx-auto" />
                        <p class="text-2xl font-semibold text-black">Isabella Catering and Events</p>
                    </header>

                    <!-- Email -->
                    <div class="flex flex-col relative">
                        <label for="logPWord" class="mb-1 text-black text-sm font-semibold">
                            Old Password
                        </label>

                        <div class="relative">
                            @* Password input*@
                            <input id="oldPWord" ng-model="oldPassword"
                                   type="password"
                                   class="w-full rounded bg-white p-2 pr-10 focus:outline-none" />

                            <!-- Toggle icon -->
                            <span id="toggleOldPassword" onclick="togglePassVisibility('oldPWord', this)"
                                  class="material-icons absolute right-3 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center cursor-pointer text-gray-500 select-none text-[20px]">
                                visibility_off
                            </span>
                        </div>
                    </div>

                    <div class="flex flex-col relative">
                        <label for="newPWord" class="mb-1 text-black text-sm font-semibold">
                            New Password
                        </label>

                        <div class="relative">
                            @* Password input*@
                            <input id="newPWord" ng-model="newPassword"
                                   type="password"
                                   class="w-full rounded bg-white p-2 pr-10 focus:outline-none" />

                            <!-- Toggle icon -->
                            <span id="toggleNewPassword" onclick="togglePassVisibility('newPWord', this)"
                                  class="material-icons absolute right-3 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center cursor-pointer text-gray-500 select-none text-[20px]">
                                visibility_off
                            </span>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="flex flex-col relative">
                        <label for="cNewPWord" class="mb-1 text-black text-sm font-semibold">
                            Confirm Password
                        </label>

                        <div class="relative">
                            @* Password input*@
                            <input id="cNewPWord" ng-model="cNewPassword"
                                   type="password"
                                   class="w-full rounded bg-white p-2 pr-10 focus:outline-none" />

                            <!-- Toggle icon -->
                            <span id="toggleCNewPassword" onclick="togglePassVisibility('cNewPWord', this)"
                                  class="material-icons absolute right-3 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center cursor-pointer text-gray-500 select-none text-[20px]">
                                visibility_off
                            </span>
                        </div>
                    </div>

                    <!-- Button -->
                    @*get the log in button to call the logInService function in the main controller when clicked*@
                    <button type="button" ng-click="logInService()"
                            class="w-full rounded bg-pink-500 py-2 text-white font-semibold hover:bg-pink-600 shadow-lg">
                        Log in
                    </button>

                </form>
            </div>
        </div>

    </body>

    <script>
        (function () {
            var progressButtons = Array.prototype.slice.call(document.querySelectorAll('#loginCarouselProgress .login-progress-btn'));
            var carouselItems = Array.prototype.slice.call(document.querySelectorAll('#default-carousel [data-carousel-item]'));

            if (!progressButtons.length || !carouselItems.length) {
                return;
            }

            function setActiveProgress() {
                var activeIndex = carouselItems.findIndex(function (item) {
                    return !item.classList.contains('hidden');
                });

                if (activeIndex >= 0) {
                    progressButtons.forEach(function (button, index) {
                        button.classList.toggle('is-active', index === activeIndex);
                    });
                }
            }

            // Initial sync
            setActiveProgress();

            // Observe changes to the carousel items
            var observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.attributeName === 'class') {
                        setActiveProgress();
                    }
                });
            });

            carouselItems.forEach(function (item) {
                observer.observe(item, { attributes: true, attributeFilter: ['class'] });
            });

            // Also handle manual clicks
            progressButtons.forEach(function (button, index) {
                button.addEventListener('click', function () {
                    setTimeout(setActiveProgress, 50);
                });
            });
        })();
    </script>
}

