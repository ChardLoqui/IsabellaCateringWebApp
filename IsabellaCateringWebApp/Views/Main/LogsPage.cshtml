@{

    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "System Logs";
}

<div class="container mx-auto h-screen p-10">
    @* Header *@
    <h1 class="text-2xl font-semibold text-black mb-6">System Logs</h1>

    @* Search & Pagination Container *@
    <div class="flex items-center justify-between mb-8 w-full">

        @* Left: Search *@
        <div class="flex items-center gap-2">
            <input type="text"
                   ng-model="searchText"
                   ng-keydown="$event.keyCode === 13 && searchLogs()"
                   placeholder="Search logs..."
                   class="w-96 px-5 rounded bg-gray-100 p-2 focus:outline-none border border-transparent focus:border-pink-500 transition-all" />

            <button type="button" ng-click="searchLogs()"
                    class="px-5 rounded bg-pink-500 py-2 text-white font-semibold hover:bg-pink-600 shadow-md transition-colors">
                Search
            </button>
        </div>

        @* Right: Pagination Controls *@
        <div class="flex items-center gap-3 text-gray-800 font-bold">
            <div class="flex items-center gap-1">
                <button ng-click="setPage(1)" ng-disabled="currentPage == 1"
                        class="hover:text-pink-500 disabled:opacity-30 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">keyboard_double_arrow_left</span>
                </button>

                <button ng-click="setPage(currentPage - 1)" ng-disabled="currentPage == 1"
                        class="hover:text-pink-500 disabled:opacity-30 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">chevron_left</span>
                </button>
            </div>

            <div class="flex items-center border rounded-md bg-white px-4 py-1 shadow-sm min-w-[40px] justify-center">
                <span class="text-sm">{{currentPage}}</span>
            </div>

            <div class="flex items-center gap-1">
                <button ng-click="setPage(currentPage + 1)" ng-disabled="currentPage >= numberOfPages()"
                        class="hover:text-pink-500 disabled:opacity-30 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">chevron_right</span>
                </button>

                <button ng-click="lastPage()" ng-disabled="currentPage >= numberOfPages()"
                        class="hover:text-pink-500 disabled:opacity-30 transition-colors flex items-center">
                    <span class="material-symbols-outlined text-xl">keyboard_double_arrow_right</span>
                </button>
            </div>
        </div>
    </div>

    @* Table *@
    <div class="overflow-x-auto shadow-sm rounded-lg">
        <table class="w-full border-collapse bg-gray-100">
            <thead>
                <tr class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-200 bg-white">
                    <th class="p-4">Log ID</th>
                    <th class="p-4">Action</th>
                    <th class="p-4">Date Updated</th>
                    <th class="p-4">User</th>
                </tr>
            </thead>
            <tbody class="text-sm text-gray-700 font-bold bg-white">
                <tr ng-repeat="log in (logsData | filter:appliedSearch) | limitTo:pageSize:(currentPage-1)*pageSize"
                    class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                    <td class="p-4">{{ log.logID }}</td>
                    <td class="p-4">{{ log.action }}</td>
                    <td class="p-4">{{ log.dateUpdated | date:'MM/dd/yyyy' }}</td>
                    <td class="p-4">{{ log.userName }}</td>
                </tr>
                @* Placeholder if no data *@
            <tr ng-if="(logsData | filter:appliedSearch).length === 0">
                <td colspan="4" class="p-10 text-center text-gray-400">
                    <div class="flex flex-col items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-4xl">search_off</span>
                        <span class="font-bold">No logs found.</span>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>