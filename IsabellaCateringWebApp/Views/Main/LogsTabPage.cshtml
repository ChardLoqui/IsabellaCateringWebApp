@{

    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "System Logs";
}

<div class="relative z-10 h-full overflow-y-auto">
    <div class="management-page-shell">
        <div class="space-y-8">
            <div class="management-page-header">
                <h1 class="management-page-title">System Logs</h1>
            </div>

            <div class="management-section-card">
                <div ng-if="logsLoading" class="management-section-header management-toolbar-loading-shell" aria-hidden="true">
                    <div class="management-section-header-row">
                        <div class="management-section-toolbar">
                            <span class="management-toolbar-loader-block management-toolbar-loader-title"></span>

                            <div class="management-section-actions">
                                <span class="management-toolbar-loader-block management-toolbar-loader-input"></span>
                                <span class="management-toolbar-loader-block management-toolbar-loader-button"></span>
                            </div>
                        </div>

                        <div class="management-toolbar-loader-pagination">
                            <div class="management-toolbar-loader-icon-group">
                                <span class="management-toolbar-loader-block management-toolbar-loader-icon"></span>
                                <span class="management-toolbar-loader-block management-toolbar-loader-icon"></span>
                            </div>

                            <div class="management-toolbar-loader-selects">
                                <span class="management-toolbar-loader-block management-toolbar-loader-select"></span>
                                <span class="management-toolbar-loader-block management-toolbar-loader-select"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div ng-if="!logsLoading" class="management-section-header management-content-fade">
                    <div class="management-section-header-row">
                        <div class="management-section-toolbar">
                            <h2 class="management-section-title">Logs</h2>

                            <div class="management-section-actions">
                                <div class="relative w-full sm:w-auto">
                                    <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[18px] text-gray-400">search</span>
                                    <input type="text"
                                           ng-model="searchState.log"
                                           ng-change="searchLogs()"
                                           placeholder="Search table data..."
                                           class="management-toolbar-input management-section-search w-full pl-12 pr-4" />
                                </div>
                            </div>
                        </div>

                        <div class="management-section-pagination management-pagination-cluster">
                            <div class="management-pagination-arrow-group">
                                <button ng-click="logsPrevPage()"
                                        ng-disabled="logsTable.currentPage === 1"
                                        class="management-pagination-icon-button">
                                    <span class="material-symbols-outlined text-xl leading-none">chevron_left</span>
                                </button>
                                <button ng-click="logsNextPage()"
                                        ng-disabled="logsTable.currentPage === getLogsTotalPages()"
                                        class="management-pagination-icon-button">
                                    <span class="material-symbols-outlined text-xl leading-none">chevron_right</span>
                                </button>
                            </div>

                            <div class="management-pagination-dropdowns">
                                <div class="management-pagination-dropdown" ng-class="{'z-20': logsPageDropOpen}">
                                    <button type="button"
                                            ng-click="logsPageDropOpen = !logsPageDropOpen; logsSizeDropOpen = false"
                                            class="management-pagination-trigger">
                                        <span class="text-xs">Page {{ logsTable.currentPage }}/{{ getLogsTotalPages() }}</span>
                                        <span class="material-symbols-outlined text-sm text-gray-400">expand_more</span>
                                    </button>

                                    <div ng-if="logsPageDropOpen" class="management-pagination-menu">
                                        <button type="button"
                                                ng-repeat="page in getLogsPageNumbers()"
                                                ng-click="logsGoToPage(page); logsPageDropOpen = false"
                                                class="management-pagination-item"
                                                ng-class="{'is-active': page === logsTable.currentPage}">
                                            Page {{ page }}
                                        </button>
                                    </div>
                                </div>

                                <div class="management-pagination-dropdown" ng-class="{'z-20': logsSizeDropOpen}">
                                    <button type="button"
                                            ng-click="logsSizeDropOpen = !logsSizeDropOpen; logsPageDropOpen = false"
                                            class="management-pagination-trigger">
                                        <span class="text-xs">{{ logsTable.pageSize }} / page</span>
                                        <span class="material-symbols-outlined text-sm text-gray-400">expand_more</span>
                                    </button>

                                    <div ng-if="logsSizeDropOpen" class="management-pagination-menu">
                                        <button type="button"
                                                ng-repeat="size in logsTable.pageSizeOptions"
                                                ng-click="setLogsPageSize(size); logsSizeDropOpen = false"
                                                class="management-pagination-item"
                                                ng-class="{'is-active': size === logsTable.pageSize}">
                                            {{ size }} rows
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="management-table-scroll">
                    <div ng-if="logsLoading" class="management-loader-shell">
                        <div class="management-loader">
                            <span class="management-loader-spinner" aria-hidden="true"></span>
                            <span>Loading logs</span>
                        </div>
                    </div>

                    <table ng-if="!logsLoading" class="management-content-fade w-full border-collapse bg-gray-100">
                        <thead>
                            <tr class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-200 bg-white">
                                <th class="p-4 cursor-pointer select-none hover:text-pink-500"
                                    ng-class="{'text-pink-500': logsTable.sortField === 'logID'}"
                                    ng-click="logsSortBy('logID')">
                                    Log ID
                                    <span class="material-symbols-outlined text-[14px] align-middle"
                                          ng-if="logsTable.sortField === 'logID'">
                                        {{ logsTable.sortReverse ? 'arrow_drop_up' : 'arrow_drop_down' }}
                                    </span>
                                </th>
                                <th class="p-4 cursor-pointer select-none hover:text-pink-500"
                                    ng-class="{'text-pink-500': logsTable.sortField === 'action'}"
                                    ng-click="logsSortBy('action')">
                                    Action
                                    <span class="material-symbols-outlined text-[14px] align-middle"
                                          ng-if="logsTable.sortField === 'action'">
                                        {{ logsTable.sortReverse ? 'arrow_drop_up' : 'arrow_drop_down' }}
                                    </span>
                                </th>
                                <th class="p-4 cursor-pointer select-none hover:text-pink-500"
                                    ng-class="{'text-pink-500': logsTable.sortField === 'dateUpdated'}"
                                    ng-click="logsSortBy('dateUpdated')">
                                    Date Updated
                                    <span class="material-symbols-outlined text-[14px] align-middle"
                                          ng-if="logsTable.sortField === 'dateUpdated'">
                                        {{ logsTable.sortReverse ? 'arrow_drop_up' : 'arrow_drop_down' }}
                                    </span>
                                </th>
                                <th class="p-4 cursor-pointer select-none hover:text-pink-500"
                                    ng-class="{'text-pink-500': logsTable.sortField === 'userName'}"
                                    ng-click="logsSortBy('userName')">
                                    User
                                    <span class="material-symbols-outlined text-[14px] align-middle"
                                          ng-if="logsTable.sortField === 'userName'">
                                        {{ logsTable.sortReverse ? 'arrow_drop_up' : 'arrow_drop_down' }}
                                    </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="text-sm text-gray-700 font-bold bg-white">
                            <tr ng-repeat="log in getLogsPage()"
                                class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                                <td class="p-4">{{ log.logID }}</td>
                                <td class="p-4">{{ log.action }}</td>
                                <td class="p-4">{{ log.dateUpdated | date:'MM/dd/yyyy' }}</td>
                                <td class="p-4">{{ log.userName }}</td>
                            </tr>
                            @* Placeholder if no data *@
                            <tr ng-if="getLogsFiltered().length === 0">
                                <td colspan="4" class="p-10 text-center text-gray-400">
                                    <div class="flex flex-col items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-4xl">search_off</span>
                                        <span class="font-bold">No logs found.</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div ng-if="!logsLoading"
                     class="px-4 py-2 border-t bg-gray-50 text-xs text-gray-400 flex flex-wrap items-center justify-between gap-3">
                    <span ng-if="getLogsFiltered().length > 0">
                        Showing {{ (logsTable.currentPage - 1) * logsTable.pageSize + 1 }}
                        – {{ [logsTable.currentPage * logsTable.pageSize, getLogsFiltered().length] | limitTo: 1 }}
                        of {{ getLogsFiltered().length }} records
                    </span>
                    <span ng-if="getLogsFiltered().length === 0">0 records</span>
                    <span>Page {{ logsTable.currentPage }} of {{ getLogsTotalPages() }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
