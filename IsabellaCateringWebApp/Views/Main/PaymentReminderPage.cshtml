	                <button ng-click="submitEditPayment()"
	                        ng-disabled="editPaymentLoading"
	                        class="flex items-center gap-2 px-5 py-2 bg-blue-500 hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-bold rounded-lg transition-colors shadow-sm">
	                    <span ng-if="editPaymentLoading" class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span>
	                    <span ng-if="!editPaymentLoading" class="material-symbols-outlined text-[18px]">check_circle</span>
	                    {{ editPaymentLoading ? 'Saving...' : 'Save Changes' }}
	                </button>
	            </div>
        </div>

    </div>
</div>
