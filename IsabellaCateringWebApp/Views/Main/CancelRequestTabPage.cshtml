@{
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    ViewBag.Title = "Cancellation Management";
}

<main class="min-h-screen bg-gray-50 text-gray-900 antialiased" ng-init="authenticateLoginCredentials(); getCancellations()">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Header Section -->
        <header class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">Cancellation Management</h1>
                <p class="mt-1 text-sm text-gray-500">Review and manage booking cancellation requests and approved records.</p>
            </div>
            <button ng-click="getCancellations()"
                    ng-disabled="cancellationsLoading"
                    class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-60">
                <span class="material-symbols-outlined text-[20px]" ng-class="{'animate-spin': cancellationsLoading}">refresh</span>
                {{ cancellationsLoading ? 'Refreshing...' : 'Refresh Data' }}
            </button>
        </header>

        <!-- Stats Overview -->
        <div ng-if="cancellationsLoading && !cancellationsLoadedOnce"
             class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2"
             aria-hidden="true">
            <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
                <div class="flex flex-col gap-3">
                    <span class="management-toolbar-loader-block cancellation-stat-loader-label"></span>
                    <div class="flex items-end gap-3">
                        <span class="management-toolbar-loader-block cancellation-stat-loader-value"></span>
                        <span class="management-toolbar-loader-block cancellation-stat-loader-meta"></span>
                    </div>
                </div>
            </div>
            <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
                <div class="flex flex-col gap-3">
                    <span class="management-toolbar-loader-block cancellation-stat-loader-label"></span>
                    <div class="flex items-end gap-3">
                        <span class="management-toolbar-loader-block cancellation-stat-loader-value"></span>
                        <span class="management-toolbar-loader-block cancellation-stat-loader-meta"></span>
                    </div>
                </div>
            </div>
        </div>

        <div ng-if="!cancellationsLoading || cancellationsLoadedOnce"
             class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 management-content-fade"
             ng-class="{'management-content-muted': cancellationsLoading && cancellationsLoadedOnce}">
            <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
                <p class="text-sm font-medium uppercase tracking-wider text-gray-500">Awaiting Approval</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-gray-900">{{cancellationRequests.length}}</h2>
                    <span class="text-sm font-medium text-pink-600">Requests</span>
                </div>
            </div>
            <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
                <p class="text-sm font-medium uppercase tracking-wider text-gray-500">Total Approved</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h2 class="text-3xl font-bold text-gray-900">{{approvedCancellations.length}}</h2>
                    <span class="text-sm font-medium text-gray-500">Cancellations</span>
                </div>
            </div>
        </div>

        <!-- Cancellation Requests Table -->
        <section class="mb-12">
            <div class="mb-4 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-pink-500"></span>
                <h3 class="text-lg font-semibold text-gray-900">Pending Cancellation Requests</h3>
            </div>

            <div ng-if="cancellationsLoading && !cancellationsLoadedOnce"
                 class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200"
                 aria-hidden="true">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Booking Info</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Client Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Event Date</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Customer Note</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <tr ng-repeat="row in [1, 2, 3, 4]">
                                <td class="whitespace-nowrap px-6 py-4">
                                    <div class="flex flex-col gap-2">
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-id"></span>
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-name"></span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-client"></span>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-date"></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-note"></span>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell-action"></span>
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell-action"></span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div ng-if="!cancellationsLoading || cancellationsLoadedOnce"
                 class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200 management-content-fade"
                 ng-class="{'management-content-muted': cancellationsLoading && cancellationsLoadedOnce}">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Booking Info</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Client Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Event Date</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Customer Note</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <tr ng-repeat="item in cancellationRequests" class="transition-colors hover:bg-gray-50">
                                <td class="whitespace-nowrap px-6 py-4">
                                    <div class="font-medium text-gray-900">#{{item.bookingID}}</div>
                                    <div class="text-sm text-gray-500">{{item.eventName}}</div>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">{{item.clientName}}</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">{{item.bookingDate}}</td>
                                <td class="px-6 py-4">
                                    <p class="max-w-xs truncate text-sm text-gray-600" title="{{item.cancelNote}}">
                                        {{item.cancelNote || 'No reason provided.'}}
                                    </p>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <button ng-click="approveCancellation(item.bookingID)" class="inline-flex items-center rounded-md bg-pink-50 px-2.5 py-1.5 text-sm font-semibold text-pink-700 hover:bg-pink-100">
                                            Approve
                                        </button>
                                        <button ng-click="rejectCancellation(item.bookingID)" class="inline-flex items-center rounded-md bg-gray-50 px-2.5 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100">
                                            Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr ng-if="cancellationsLoadedOnce && cancellationRequests.length === 0">
                                <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-500">
                                    No pending cancellation requests found.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Approved Cancellations Table -->
        <section>
            <div class="mb-4 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-gray-400"></span>
                <h3 class="text-lg font-semibold text-gray-900">Approved Cancellations</h3>
            </div>

            <div ng-if="cancellationsLoading && !cancellationsLoadedOnce"
                 class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200"
                 aria-hidden="true">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Booking Info</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Client Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Date Cancelled</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Admin Note</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <tr ng-repeat="row in [1, 2, 3, 4]">
                                <td class="whitespace-nowrap px-6 py-4">
                                    <div class="flex flex-col gap-2">
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-id"></span>
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-name"></span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-client"></span>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-date"></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-note-wide"></span>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-right">
                                    <div class="flex justify-end">
                                        <span class="management-toolbar-loader-block cancellation-table-loader-cell cancellation-table-loader-cell-link"></span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div ng-if="!cancellationsLoading || cancellationsLoadedOnce"
                 class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200 management-content-fade"
                 ng-class="{'management-content-muted': cancellationsLoading && cancellationsLoadedOnce}">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Booking Info</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Client Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Date Cancelled</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Admin Note</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <tr ng-repeat="item in approvedCancellations" class="transition-colors hover:bg-gray-50">
                                <td class="whitespace-nowrap px-6 py-4">
                                    <div class="font-medium text-gray-900">#{{item.bookingID}}</div>
                                    <div class="text-sm text-gray-500">{{item.eventName}}</div>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">{{item.clientName}}</td>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">{{item.dateCancelled}}</td>
                                <td class="px-6 py-4">
                                    <p class="max-w-xs truncate text-sm text-gray-600" title="{{item.acceptedCancelNote}}">
                                        {{item.acceptedCancelNote || 'No note.'}}
                                    </p>
                                </td>
                                <td class="whitespace-nowrap px-6 py-4 text-right">
                                    <button ng-click="viewBookingDetails(item.bookingID);" class="text-sm font-medium text-pink-600 hover:text-pink-900">
                                        View Booking
                                    </button>
                                </td>
                            </tr>
                            <tr ng-if="cancellationsLoadedOnce && approvedCancellations.length === 0">
                                <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-500">
                                    No approved cancellations found.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</main>
