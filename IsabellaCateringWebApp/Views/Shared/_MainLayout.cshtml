@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <!-- tailwind link -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- google fonts n icons link -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />

    <!-- flowbite -->
    <script src="https://unpkg.com/flowbite@1.7.0/dist/flowbite.js"></script>
    <!-- Sweet Alert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body class="bg-white main-layout" ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController">

    <aside class="sidebar fixed top-0 left-0 z-50 flex h-screen flex-col overflow-hidden">
        @*Logo*@
        <div class="sidebar-logo flex h-20 items-center justify-center py-5">
            <img alt="Logo" class="object-contain" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT227MyD8qjI-JTi-7ePbzikpEkkV9oSKs7cA&s" />
        </div>
        @*Navbar*@
        <nav class="flex-1 py-4">
            <ul class="space-y-1">
                <li class="nav-item">
                    <a class="group flex items-center px-6 py-3 transition-all duration-200
               @(currentAction == "CustomerViewPage" && currentController == "Main" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                       href="@Url.Action("CustomerViewPage", "Main")">
                        <span class="material-symbols-outlined nav-icon min-w-[24px]">timeline</span>
                        <span class="nav-text">Event Progress</span>
                    </a>
                </li>
            </ul>
        </nav>
        @*Profile section*@
        <div class="border-t border-gray-400 p-3" ng-cloak>
            <div class="mb-4 flex items-center">
                <img alt="Profile" class="h-10 w-10 flex-shrink-0 rounded-full"
                     src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" />

                <div class="profile-info ml-3">
                    <p class="profile-name text-sm font-semibold text-black">
                        {{ sessionInfo.name }}
                    </p>
                    <p class="profile-role text-xs text-pink-500">
                        {{ sessionInfo.role }}
                    </p>
                </div>
            </div>
        </div>
        @*Logout*@
        <a class="logout-btn flex items-center rounded-lg px-6 py-5 text-black transition-all duration-200" href="@Url.Action("LoginPage", "Main")">
            <span class="material-symbols-outlined logout-icon transition-colors duration-200 min-w-[24px]">logout</span>
            <span class="nav-text font-medium">Log Out</span>
        </a>
    </aside>

    <!-- laman ng page -->
    <main class="main-content relative h-screen flex-1 overflow-hidden bg-white">
        @RenderBody()
    </main>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>

</body>
</html>
