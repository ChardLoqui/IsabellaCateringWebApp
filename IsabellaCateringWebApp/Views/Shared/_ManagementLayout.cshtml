@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentPerm = Session["currentPerm"]?.ToString();
    var showManagementNav = false;
    int parsedPerm;

    if (int.TryParse(currentPerm, out parsedPerm))
    {
        showManagementNav = parsedPerm < 3;
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <!-- tailwind link -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- google fonts n icons link -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />

    <!-- flowbite -->
    <script src="https://unpkg.com/flowbite@1.7.0/dist/flowbite.js"></script>
    <!-- Sweet Alert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- PDFmaker -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <style>
        .sidebar {
            width: 80px;
            transition: width 0.3s ease;
            background: #FCD1E5;
        }

            .sidebar:hover {
                width: 260px;
            }

        .main-content {
            margin-left: 80px;
            transition: margin-left 0.3s ease;
        }

        .sidebar:hover ~ .main-content {
            margin-left: 260px;
        }

        .nav-text {
            opacity: 0;
            width: 0;
            overflow: hidden;
            white-space: nowrap;
            transition: opacity 0.3s ease, width 0.3s ease;
        }

        .sidebar:hover .nav-text {
            opacity: 1;
            width: auto;
        }

        .sidebar-logo img {
            width: 130px;
            transition: width 0.3s ease;
        }

        .sidebar:hover .sidebar-logo img {
            width: 130px;
        }

        .profile-info {
            opacity: 0;
            width: 0;
            overflow: hidden;
            transition: opacity 0.3s ease, width 0.3s ease;
        }

        .sidebar:hover .profile-info {
            opacity: 1;
            width: auto;
        }

        .nav-item {
            position: relative;
        }

            .nav-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background: #FF69B4;
                transform: scaleY(0);
                transition: transform 0.3s ease;
            }

            .nav-item:hover::before {
                transform: scaleY(1);
            }

            .nav-item a:hover {
                background-color: rgba(255, 152, 203, 0.2) !important;
                color: #e6328c !important;
            }

                .nav-item a:hover i {
                    color: #e6328c !important;
                }

        .logout-btn:hover {
            background-color: #FF69B4 !important;
            color: white !important;
        }

            .logout-btn:hover i {
                color: white !important;
            }
    </style>

</head>

<body class="bg-white management-layout" ng-app="IsabellaCateringWebApp" ng-controller="IsabellaCateringWebAppController">

    <aside class="sidebar fixed top-0 left-0 z-50 flex h-screen flex-col overflow-hidden">
        @*Logo*@
        <div class="sidebar-logo flex h-20 items-center justify-center py-5">
            <img alt="Logo" class="object-contain" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT227MyD8qjI-JTi-7ePbzikpEkkV9oSKs7cA&s" />
        </div>
        @*Navbar*@
        <nav class="flex-1 py-4">
            <ul class="space-y-1">
                @if (showManagementNav)
                {
                    <li class="nav-item">
                        <a class="group flex items-center px-6 py-3 transition-all duration-200
                   @(currentAction == "BookingCalendarPage" && currentController == "Main" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                           href="@Url.Action("BookingCalendarPage", "Main")">
                            <span class="material-symbols-outlined nav-icon min-w-[24px]">calendar_month</span>
                            <span class="nav-text">Booking Calendar</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="group flex items-center px-6 py-3 transition-all duration-200
                   @(currentAction == "PaymentReminderPage" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                           href="@Url.Action("PaymentReminderPage", "Main")">
                            <span class="material-symbols-outlined nav-icon min-w-[24px]">account_balance_wallet</span>
                            <span class="nav-text">Manage Payment</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="group flex items-center px-6 py-3 transition-all duration-200
                   @(currentAction == "AccountsPage" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                           href="@Url.Action("AccountsPage", "Main")">
                            <span class="material-symbols-outlined nav-icon min-w-[24px]">groups</span>
                            <span class="nav-text">Accounts</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="group flex items-center px-6 py-3 transition-all duration-200
                   @(currentAction == "LogsPage" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                           href="@Url.Action("LogsPage", "Main")">
                            <span class="material-symbols-outlined nav-icon min-w-[24px]">article</span>
                            <span class="nav-text">Logs</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="group flex items-center px-6 py-3 transition-all duration-200
                    @(currentAction == "CustomerViewPage" && currentController == "Main" ? "bg-pink-100 text-pink-600 border-r-4 border-pink-500 font-bold" : "text-black font-medium")"
                           href="@Url.Action("CustomerViewPage", "Main")">
                            <span class="material-symbols-outlined nav-icon min-w-[24px]">timeline</span>
                            <span class="nav-text">Event Progress</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
        @*Profile section*@
        <div class="border-t border-gray-400 p-3" ng-cloak>
            <div class="mb-4 flex items-center">
                <img alt="Profile" class="h-10 w-10 flex-shrink-0 rounded-full"
                     src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" />

                <div class="profile-info ml-3">
                    <p class="profile-name text-sm font-semibold text-black">
                        {{ sessionInfo.name }}
                    </p>
                    <p class="profile-role text-xs text-pink-500">
                        {{ sessionInfo.role }}
                    </p>
                </div>
            </div>
        </div>
        @*Logout*@
        <a class="logout-btn flex items-center rounded-lg px-6 py-5 text-black transition-all duration-200" href="@Url.Action("LoginPage", "Main")" ng-click="logOut()">
            <span class="material-symbols-outlined logout-icon transition-colors duration-200 min-w-[24px]">logout</span>
            <span class="nav-text font-medium">Log Out</span>
        </a>
    </aside>

    <!-- laman ng page -->
    <main class="main-content relative h-screen flex-1">
        @RenderBody()
    </main>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/HolyScripts/Module.js?v=20260407b"></script>
    <script src="~/Scripts/HolyScripts/Service.js?v=20260407b"></script>
    <script src="~/Scripts/HolyScripts/Controller.js?v=20260422c"></script>

</body>
</html>
